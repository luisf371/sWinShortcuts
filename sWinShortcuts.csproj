<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Icons\Icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\Icon.ico" />
    <Resource Include="Icons\Crosshair.png" />
  </ItemGroup>

  <!-- Build stamp: CI passes -p:BuildNumber=<run number> to dotnet publish (see ci.yml); local
       builds get the "dev" fallback. GenerateAssemblyInfo=false above disables the SDK's
       AssemblyAttribute pipeline, so emit the metadata attribute ourselves into obj/ and hand it
       to the compiler — Utilities/BuildInfo.cs reads it back at runtime for the Settings label.
       The file is tiny, so regenerate it for every real app compile; this keeps BuildNumber changes
       correct in a reused obj while avoiding a second writer from WPF's temporary assembly build. -->
  <PropertyGroup>
    <BuildNumber Condition="'$(BuildNumber)' == ''">dev</BuildNumber>
  </PropertyGroup>
  <Target Name="GenerateBuildMetadata"
          BeforeTargets="BeforeCompile"
          Condition="!$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
    <ItemGroup>
      <BuildMetadataAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildNumber</_Parameter1>
        <_Parameter2>$(BuildNumber)</_Parameter2>
      </BuildMetadataAttribute>

      <!-- Dev-only timestamp (local machine time) so a local exe has a "when did I compile this"
           reference; numbered CI builds get no wall-clock metadata and their label stays "Build N".
           WriteCodeFragment rewrites the whole file each real compile, so a reused obj never keeps
           a stale BuildDate after a switch dev -> N -> dev. -->
      <BuildMetadataAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                              Condition="'$(BuildNumber)' == 'dev'">
        <_Parameter1>BuildDate</_Parameter1>
        <_Parameter2>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</_Parameter2>
      </BuildMetadataAttribute>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(BuildMetadataAttribute)"
                       Language="C#"
                       OutputFile="$(IntermediateOutputPath)GeneratedBuildInfo.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>

</Project>
