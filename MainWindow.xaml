<Window x:Class="sWinShortcuts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:sWinShortcuts.ViewModels"
        xmlns:models="clr-namespace:sWinShortcuts.Models"
        xmlns:conv="clr-namespace:sWinShortcuts.Converters"
        xmlns:behaviors="clr-namespace:sWinShortcuts.Behaviors"
        Title="sWinShortcuts"
        Icon="pack://application:,,,/Icons/Icon.ico"
        Width="960"
        Height="720"
        MinWidth="960"
        MaxWidth="960"
        MinHeight="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        x:Name="RootWindow"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged">
    <WindowChrome.WindowChrome>
        <!-- ResizeBorderThickness sides are 0 on purpose: the window's width is locked
             (MinWidth == MaxWidth), so side/corner hit zones would only produce
             no-op or diagonal (width) resize cursors. Top/bottom bands remain for
             height resizing; zero-width side bands make the corner hit tests
             resolve to the vertical edges instead of HTBOTTOMRIGHT/HTTOPLEFT. -->
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0,5,0,5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BooleanNegationConverter x:Key="NotConverter" />
        <conv:KeyDisplayConverter x:Key="KeyDisplayConverter" />
        <conv:MouseButtonDisplayConverter x:Key="MouseButtonDisplayConverter" />
        <conv:InputTriggerDisplayConverter x:Key="InputTriggerDisplayConverter" />
        <conv:AvailableMouseButtonsConverter x:Key="AvailableMouseButtonsConverter" />
        <conv:AvailableTriggerKeysConverter x:Key="AvailableTriggerKeysConverter" />
        <conv:BooleanToVisibilityConverterEx x:Key="VisibleIfTrue" />
        <conv:BooleanToVisibilityConverterEx x:Key="VisibleIfFalse" Invert="True" />
        
        <Style x:Key="DisabledContentShadeStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeatureToggleContentStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                    <Setter Property="Opacity" Value="0.75" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Heavier than DisabledContentShadeStyle (0.6): the Advanced page under a locked
             Advanced Mode must read unmistakably disabled, not merely idle. -->
        <Style x:Key="LockedContentShadeStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Keyed (window-local on purpose: promoting it would restyle the Settings dialog).
             Page scroller for the profile editor tabs; overlays the minimal scrollbar inside
             the right padding. Pages set their own Padding (the old single-scroller
             24,16,28,24). -->
        <Style x:Key="SettingsScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" />
                            <Border Margin="{TemplateBinding Padding}">
                                <!-- No HorizontalAlignment binding on purpose: binding to
                                     HorizontalContentAlignment (Control default = Left) left-aligns
                                     the presenter and arranges the page at its DESIRED width, so
                                     the GroupBoxes/setting rows shrink-wrap to their widest child
                                     instead of stretching to the card edge. -->
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Margin="0,16,1,16"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       VerticalAlignment="Bottom"
                                       Margin="16,0,16,16"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                x:Name="TitleBar"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="sWinShortcuts"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="12,0,0,0"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"
                           FontSize="12" />
                <StackPanel Orientation="Horizontal"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top">
                    <Button x:Name="PinButton"
                            Click="PinButton_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.Placement="Right"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontSize="12" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button Click="SettingsButton_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Settings"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.Placement="Right"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE713;" FontSize="12" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button Click="CloseButton_Click"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Minimize to tray"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.Placement="Right">
                        <TextBlock Text="&#xE8BB;" FontSize="12" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="16,8,16,16"
                Padding="16"
                Background="{DynamicResource BackgroundElevatedBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource ForegroundPrimaryBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text=" (disabled)" Margin="6,0,0,0" Foreground="{StaticResource ForegroundPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Add" Command="{Binding AddProfileCommand}" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveProfileCommand}" Margin="6,0,0,0" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="16,8,16,16"
                Padding="0"
                Background="{DynamicResource BackgroundElevatedBrush}"
                CornerRadius="12"
                ClipToBounds="True">
                <ContentControl Content="{Binding SelectedProfile}">
                                        <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                            <!-- Docked root, NOT a vertical StackPanel: a StackPanel measures its
                                 children with infinite height, which makes the tab pages'
                                 ScrollViewers see an unbounded viewport — no scrolling, content
                                 overflows the card. Docked header + filling content keeps the
                                 TabControl's height finite. -->
                            <DockPanel Margin="0">
                                <CheckBox DockPanel.Dock="Top" Margin="24,16,24,4"
                                          IsChecked="{Binding IsEnabled}"
                                          IsEnabled="{Binding CanToggleEnabled}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center"
                                          Padding="5">
                                    <!-- Edit icon sits immediately right of the name (StackPanel
                                         layout follows the name's length). F-017: executable edits
                                         go through the validated Modify flow only. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Button Content="&#xE70F;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ModifyProfileCommand, ElementName=RootWindow}"
                                                Visibility="{Binding IsCustomProfile, Converter={StaticResource VisibleIfTrue}}"
                                                ToolTip="Edit executable target (validated)"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Right"
                                                AutomationProperties.Name="Edit executable" />
                                    </StackPanel>
                                </CheckBox>

                                <DockPanel IsEnabled="{Binding CanEditContent}"
                                           Style="{StaticResource DisabledContentShadeStyle}">

                    <!-- Pinned tab strip; each tab page brings its own ScrollViewer so the
                         strip never scrolls away. Direct-content TabItems keep state (scroll
                         position, DataGrid selection) across tab switches. -->
                    <TabControl Margin="0,6,0,0"
                                Style="{StaticResource SettingsTabControlStyle}"
                                ItemContainerStyle="{StaticResource SettingsTabItemStyle}"
                                SelectedIndex="{Binding DataContext.SelectedTabIndex, ElementName=RootWindow, Mode=TwoWay}">
                        <TabControl.Resources>
                    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#331E2A3B" />
                    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#88E1E1E1" />
                    <Style x:Key="MinimalScrollBarButtonStyle" TargetType="RepeatButton">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="MinimalScrollBarThumbStyle" TargetType="Thumb">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbRoot"
                                            Background="{StaticResource ScrollBarThumbBrush}"
                                            CornerRadius="4" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbRoot"
                                                    Property="Background"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbRoot"
                                                    Property="Background"
                                                    Value="{DynamicResource AccentDarkBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8" />
                        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="Root"
                                          Width="{TemplateBinding Width}"
                                          Background="Transparent">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" />
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="True"
                                               Margin="0">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                                              Style="{StaticResource MinimalScrollBarButtonStyle}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                                              Style="{StaticResource MinimalScrollBarButtonStyle}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                        </TabControl.Resources>
                        <!-- Launcher is built-in-only (hosts the Windows Launcher group) and first
                             in the strip, so the built-in default opens on it: Launcher, Display,
                             System. Local Visibility binding — same pattern as Keys below. -->
                        <TabItem Header="Launcher"
                                 Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfTrue}}">
                            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}"
                                          Padding="24,16,28,24">
                                <StackPanel>
                                    <GroupBox Padding="16" Margin="0,0,0,8">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Windows Launcher"
                                                          IsChecked="{Binding WindowsLauncherEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Press Win plus the listed key to launch the configured application. Run as admin starts it elevated."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding WindowsLauncherEnabled}"
                                                    Tag="{Binding WindowsLauncherEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <ItemsControl ItemsSource="{Binding WindowsLaunchers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:WindowsLauncherEntryViewModel}">
                                                        <DockPanel Margin="0,4,0,4">
                                                            <StackPanel Orientation="Horizontal" Width="140" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="Win+" Foreground="{StaticResource ForegroundPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Key, Converter={StaticResource KeyDisplayConverter}}" Foreground="{StaticResource ForegroundPrimaryBrush}" />
                                                            </StackPanel>
                                                            <CheckBox Content="Run as admin" IsChecked="{Binding RunAsAdministrator}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                            <Button Content="Browse"
                                                                    Command="{Binding DataContext.BrowseLauncherTargetCommand, ElementName=RootWindow}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right"
                                                                    Margin="8,0,0,0"
                                                                    Width="100" />
                                                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Keys"
                                 Visibility="{Binding IsCustomProfile, Converter={StaticResource VisibleIfTrue}}">
                            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}"
                                          Padding="24,16,28,24">
                                <StackPanel>
                                    <!-- Combined Key Mappings (Global + Right-click) -->
                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Key Re-Mappings"
                                                          IsChecked="{Binding CombinedKeyMappingsEnabled, Mode=TwoWay}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Single list of mappings. Toggle Right-click column to apply only while holding right button. The toggle enables/disables both global and right-click mappings."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding CombinedKeyMappingsEnabled}"
                                                    Tag="{Binding CombinedKeyMappingsEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">

                                            <DataGrid ItemsSource="{Binding CombinedMappings}"
                                                      SelectedItem="{Binding SelectedCombinedMapping, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserReorderColumns="False"
                                                      CanUserResizeColumns="False"
                                                      CanUserDeleteRows="False"
                                                      Margin="0,0,0,8"
                                                      RowHeight="32"
                                                      BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Source" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox SelectedItem="{Binding SourceKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          ItemsSource="{Binding SelectableSourceKeys}"
                                                                          IsSynchronizedWithCurrentItem="False"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Target" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.KeyOptions, ElementName=RootWindow}"
                                                                          SelectedItem="{Binding TargetKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsSynchronizedWithCurrentItem="False"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Width="Auto">
                                                        <DataGridTemplateColumn.Header>
                                                            <StackPanel Orientation="Horizontal"
                                                                        ToolTip="When checked, the mapping applies only while the right mouse button is held. Unchecked mappings are always active (global)."
                                                                        ToolTipService.InitialShowDelay="0"
                                                                        ToolTipService.Placement="Right">
                                                                <TextBlock Text="Right-click" VerticalAlignment="Center" />
                                                                <TextBlock Style="{StaticResource InfoIconStyle}" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding RightClickOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Width="Auto">
                                                        <DataGridTemplateColumn.Header>
                                                            <StackPanel Orientation="Horizontal"
                                                                        ToolTip="⚠️ WARNING: Turning Suppression Off violates '1 key = 1 action' gaming rules. Use at your own risk."
                                                                        ToolTipService.InitialShowDelay="0"
                                                                        ToolTipService.Placement="Right">
                                                                <TextBlock Text="Suppress" VerticalAlignment="Center" />
                                                                <TextBlock Style="{StaticResource WarningIconStyle}" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding SuppressOriginalKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding DataContext.AdvancedModeEnabled, ElementName=RootWindow}"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="🗑️" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕"
                                                                        Command="{Binding DataContext.RemoveCombinedMappingCommand, ElementName=RootWindow}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="30"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        FontSize="14"
                                                                        ToolTip="Remove this mapping"
                                                                        ToolTipService.InitialShowDelay="0"
                                                                        ToolTipService.Placement="Right" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Add Mapping"
                                                        Command="{Binding DataContext.AddCombinedMappingCommand, ElementName=RootWindow}"
                                                        Width="130"
                                                        Height="32" />
                                                <Button Grid.Column="1"
                                                        Content="Remove All Mappings"
                                                        Command="{Binding DataContext.RemoveAllCombinedMappingsCommand, ElementName=RootWindow}"
                                                        Width="170"
                                                        Margin="16,0,0,0"
                                                        Height="32"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Alt + Mouse Shortcuts"
                                                          IsChecked="{Binding AltMouse.IsEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Hold Alt and click mouse buttons to trigger tap/hold actions. Configure button mappings and hold threshold below."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding AltMouse.IsEnabled}"
                                                    Tag="{Binding AltMouse.IsEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <!-- Setting rows are Grids: 140px label column + * control
                                                 column, so every group's controls span the full card
                                                 width like the Keys tab DataGrid instead of stopping
                                                 at each control's fixed width. -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Hold threshold (ms)"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding AltMouse.HoldThresholdMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="10"
                                                            Maximum="1000"
                                                            TickFrequency="5"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AltMouse.HoldThresholdMilliseconds, StringFormat='{}{0} ms'}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding AltMouse.ResetHoldThresholdCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>

                                            <DataGrid ItemsSource="{Binding AltMouseBindings}"
                                                      AutoGenerateColumns="False"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserReorderColumns="False"
                                                      CanUserResizeColumns="False"
                                                      CanUserDeleteRows="False"
                                                      Margin="0,0,0,8"
                                                      RowHeight="32"
                                                      BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Button" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox SelectedItem="{Binding Button, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                                                          IsSynchronizedWithCurrentItem="False">
                                                                    <ComboBox.ItemsSource>
                                                                        <MultiBinding Converter="{StaticResource AvailableMouseButtonsConverter}" UpdateSourceTrigger="PropertyChanged">
                                                                            <Binding Path="DataContext.SelectedProfile.AvailableMouseButtons" ElementName="RootWindow" Mode="OneWay" />
                                                                            <Binding Path="Button" Mode="OneWay" />
                                                                        </MultiBinding>
                                                                    </ComboBox.ItemsSource>
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource MouseButtonDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Tap" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.KeyOptionsWithNone, ElementName=RootWindow}"
                                                                          SelectedItem="{Binding TapKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Hold" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.KeyOptionsWithNone, ElementName=RootWindow}"
                                                                          SelectedItem="{Binding HoldKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="🗑️" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕"
                                                                        Command="{Binding DataContext.RemoveAltMouseBindingCommand, ElementName=RootWindow}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="30"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        FontSize="14"
                                                                        ToolTip="Remove this binding"
                                                                        ToolTipService.InitialShowDelay="0"
                                                                        ToolTipService.Placement="Right" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Add Binding"
                                                        Command="{Binding DataContext.AddAltMouseBindingCommand, ElementName=RootWindow}"
                                                        Width="130"
                                                        Height="32" />
                                                <Button Grid.Column="1"
                                                        Content="Remove All Bindings"
                                                        Command="{Binding DataContext.RemoveAllAltMouseBindingsCommand, ElementName=RootWindow}"
                                                        Width="170"
                                                        Margin="16,0,0,0"
                                                        Height="32"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Alt + Keyboard Shortcuts"
                                                          IsChecked="{Binding AltKeyboard.IsEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Hold Alt and press keyboard keys to trigger tap/hold actions. Configure key mappings and hold threshold below."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding AltKeyboard.IsEnabled}"
                                                    Tag="{Binding AltKeyboard.IsEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <!-- Setting rows are Grids: 140px label column + * control
                                                 column, so every group's controls span the full card
                                                 width like the Keys tab DataGrid instead of stopping
                                                 at each control's fixed width. -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Hold threshold (ms)"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding AltKeyboard.HoldThresholdMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="10"
                                                            Maximum="1000"
                                                            TickFrequency="5"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AltKeyboard.HoldThresholdMilliseconds, StringFormat='{}{0} ms'}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding AltKeyboard.ResetHoldThresholdCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>

                                            <DataGrid ItemsSource="{Binding AltKeyboardBindings}"
                                                      AutoGenerateColumns="False"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserReorderColumns="False"
                                                      CanUserResizeColumns="False"
                                                      CanUserDeleteRows="False"
                                                      Margin="0,0,0,8"
                                                      RowHeight="32"
                                                      BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Key" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox SelectedItem="{Binding TriggerKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True"
                                                                          IsSynchronizedWithCurrentItem="False">
                                                                    <ComboBox.ItemsSource>
                                                                        <MultiBinding Converter="{StaticResource AvailableTriggerKeysConverter}" UpdateSourceTrigger="PropertyChanged">
                                                                            <Binding Path="DataContext.SelectedProfile.AvailableTriggerKeys" ElementName="RootWindow" Mode="OneWay" />
                                                                            <Binding Path="TriggerKey" Mode="OneWay" />
                                                                        </MultiBinding>
                                                                    </ComboBox.ItemsSource>
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Tap" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.KeyOptionsWithNone, ElementName=RootWindow}"
                                                                          SelectedItem="{Binding TapKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Hold" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.KeyOptionsWithNone, ElementName=RootWindow}"
                                                                          SelectedItem="{Binding HoldKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="🗑️" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕"
                                                                        Command="{Binding DataContext.RemoveAltKeyboardBindingCommand, ElementName=RootWindow}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="30"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        FontSize="14"
                                                                        ToolTip="Remove this binding"
                                                                        ToolTipService.InitialShowDelay="0"
                                                                        ToolTipService.Placement="Right" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Add Binding"
                                                        Command="{Binding DataContext.AddAltKeyboardBindingCommand, ElementName=RootWindow}"
                                                        Width="130"
                                                        Height="32" />
                                                <Button Grid.Column="1"
                                                        Content="Remove All Bindings"
                                                        Command="{Binding DataContext.RemoveAllAltKeyboardBindingsCommand, ElementName=RootWindow}"
                                                        Width="170"
                                                        Margin="16,0,0,0"
                                                        Height="32"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Custom profiles only; Windows and Color profiles hide it entirely.
                             Visibility uses the SAME local-binding pattern as the Keys tab —
                             style-based Visibility setters on these TabItem containers do not
                             hide the tab reliably at runtime (empirically verified 2026-08-18;
                             the sibling local bindings behave). With Advanced Mode off the tab
                             stays clickable at full contrast: the page is gated + shaded (root
                             panel gate + LockedContentShadeStyle) with a lock notice up top. -->
                        <TabItem Visibility="{Binding IsCustomProfile, Converter={StaticResource VisibleIfTrue}}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal"
                                            AutomationProperties.Name="Advanced">
                                    <TextBlock Text="Advanced" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}"
                                          Padding="24,16,28,24">
                                <StackPanel>
                                    <!-- Lock notice: sits OUTSIDE the gated panel below so it stays
                                         full-contrast while the options are shaded. -->
                                    <Border Visibility="{Binding DataContext.AdvancedModeEnabled, ElementName=RootWindow, Converter={StaticResource VisibleIfFalse}}"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,12">
                                        <TextBlock Text="🔒 Advanced features are locked — enable Advanced Mode in Settings to use them."
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource ForegroundSecondaryBrush}" />
                                    </Border>
                                    <!-- Single gate for the whole page (child IsEnabled bindings
                                         would be redundant: IsEnabled inherits down the tree). -->
                                    <StackPanel IsEnabled="{Binding DataContext.AdvancedModeEnabled, ElementName=RootWindow}"
                                                Style="{StaticResource LockedContentShadeStyle}">
                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Rapid Fire"
                                                          IsChecked="{Binding RapidFireEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="While armed with the app-level toggle key, holding the left mouse button sends repeated left clicks at the interval configured below."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                                <TextBlock Style="{StaticResource WarningIconStyle}"
                                                           ToolTip="⚠️ WARNING: Rapid-fire automation may violate game or anti-cheat rules. Timing jitter is not ban protection. Use at your own risk."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding RapidFireEnabled}"
                                                    Tag="{Binding RapidFireEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <TextBlock Margin="0,0,0,8"
                                                       Foreground="{StaticResource ForegroundSecondaryBrush}">
                                                <Run Text="Toggle key: " />
                                                <Run Text="{Binding DataContext.RapidFireToggleKey, ElementName=RootWindow, Converter={StaticResource KeyDisplayConverter}, Mode=OneWay}" />
                                                <Run Text=" — assigned in Settings" />
                                            </TextBlock>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Click interval (ms)"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding RapidFireIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="25"
                                                            Maximum="250"
                                                            TickFrequency="5"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RapidFireIntervalMilliseconds, StringFormat='{}{0} ms'}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding ResetRapidFireIntervalCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Jitter (ms)"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource InfoIconStyle}"
                                                               ToolTipService.InitialShowDelay="0"
                                                               ToolTipService.Placement="Right">
                                                        <TextBlock.ToolTip>
                                                            <TextBlock MaxWidth="360" TextWrapping="Wrap">
                                                                <Run Text="Adds a random 0 –" />
                                                                <Run Text="{Binding RapidFireJitterMilliseconds, Mode=OneWay}" />
                                                                <Run Text=" ms to the base interval." />
                                                                <LineBreak />
                                                                <Run Text="Current total interval: " />
                                                                <Run Text="{Binding RapidFireTimingRange, Mode=OneWay}" />
                                                                <Run Text="." />
                                                                <LineBreak />
                                                                <Run Text="This varies timing only and is not ban protection." />
                                                            </TextBlock>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding RapidFireJitterMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0"
                                                            Maximum="20"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RapidFireJitterMilliseconds, StringFormat='{}{0} ms'}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding ResetRapidFireJitterCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Right Click - Hold Breath"
                                                          IsChecked="{Binding RightClickHoldBreathEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Upon right mouse button down, after a delay, press or toggle the hold breath key. Release on right mouse button up."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                                <TextBlock Style="{StaticResource WarningIconStyle}"
                                                           ToolTip="⚠️ WARNING: This violates '1 key = 1 action' rules in competitive or anti-cheat restricted games. Use at your own risk."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding RightClickHoldBreathEnabled}"
                                                    Tag="{Binding RightClickHoldBreathEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Hold breath key"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.KeyOptions, ElementName=RootWindow}"
                                                          SelectedItem="{Binding RightClickHoldBreathKey, Mode=TwoWay}"
                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Mode" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.HoldBreathModes, ElementName=RootWindow}"
                                                          SelectedItem="{Binding RightClickHoldBreathMode, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Delay (ms)"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding RightClickHoldBreathDelay, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0"
                                                            Maximum="500"
                                                            TickFrequency="5"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RightClickHoldBreathDelay, StringFormat='{}{0} ms'}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding ResetHoldBreathDelayCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox Content="Early Cancel"
                                                              IsChecked="{Binding RightClickHoldBreathSuppressEarlyCancelInput, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource InfoIconStyle}"
                                                               ToolTip="When enabled, press the selected trigger while right mouse is held to cancel hold-breath while it is waiting or holding a key. Only the successful cancel press is blocked; later presses pass through until the next aim (releasing and pressing right mouse again re-arms Early Cancel)."
                                                               ToolTipService.InitialShowDelay="0"
                                                               ToolTipService.Placement="Right" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.HoldBreathPanicTriggers, ElementName=RootWindow}"
                                                          SelectedItem="{Binding RightClickHoldBreathPanicTrigger, Mode=TwoWay}"
                                                          IsEnabled="{Binding RightClickHoldBreathSuppressEarlyCancelInput}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource InputTriggerDisplayConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Auto-Run"
                                                          IsChecked="{Binding AutoRunEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Press the trigger key to toggle auto-run (continuous forward movement). Choose None to use the key by itself, or select a modifier to require a combo. Enable Sprint to also send a sprint key while auto-running."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                                <TextBlock Style="{StaticResource WarningIconStyle}"
                                                           ToolTip="⚠️ WARNING: Automated / continuous input violates '1 key = 1 action' rules in competitive or anti-cheat restricted games. Use at your own risk."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding AutoRunEnabled}"
                                                    Tag="{Binding AutoRunEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Trigger modifier"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.TriggerModifiers, ElementName=RootWindow}"
                                                          SelectedItem="{Binding AutoRunTriggerModifier, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Trigger key"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.KeyOptions, ElementName=RootWindow}"
                                                          SelectedItem="{Binding AutoRunTriggerKey, Mode=TwoWay}"
                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="Auto-Sprint"
                                                          IsChecked="{Binding AutoRunSprintEnabled}"
                                                          VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.KeyOptions, ElementName=RootWindow}"
                                                          SelectedItem="{Binding AutoRunSprintKey, Mode=TwoWay}"
                                                          IsEnabled="{Binding AutoRunSprintEnabled}"
                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,0,0,8"
                                                  IsEnabled="{Binding AutoRunSprintEnabled}"
                                                  Tag="{Binding AutoRunSprintEnabled}"
                                                  Style="{StaticResource FeatureToggleContentStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sprint mode"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.SprintActivationModes, ElementName=RootWindow}"
                                                          SelectedItem="{Binding AutoRunSprintMode, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Send mode"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource WarningIconStyle}"
                                                               ToolTip="⚠️ EXPERIMENTAL: Background mode sends keys directly to the application allowing for movement while alt-tabbed."
                                                               ToolTipService.InitialShowDelay="0"
                                                               ToolTipService.Placement="Right" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.AutoRunSendModes, ElementName=RootWindow}"
                                                          SelectedItem="{Binding AutoRunSendMode, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsWindowsProfile, Converter={StaticResource VisibleIfFalse}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Anti-AFK"
                                                          IsChecked="{Binding AntiAfkEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Prevents idle kicks by sending WASD tap — but ONLY after your KEYBOARD has been genuinely inactive for the set interval (mouse movement does NOT reset it). Any real keypress resets the timer, so it never fires while you're actively playing, and it only runs while this game is focused."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding AntiAfkEnabled}"
                                                    Tag="{Binding AntiAfkEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Interval (min)"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource InfoIconStyle}"
                                                               ToolTip="How long the keyboard must be genuinely inactive before the WASD tap fires. Mouse movement does NOT reset the timer; any real keypress does. Only runs while the application is in the foreground."
                                                               ToolTipService.InitialShowDelay="0"
                                                               ToolTipService.Placement="Right" />
                                                </StackPanel>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding AntiAfkIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="1"
                                                            Maximum="15"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AntiAfkIntervalMinutes, StringFormat='{}{0} min'}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding ResetAntiAfkIntervalCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="Only triggers after real KEYBOARD inactivity (mouse movement does not). Application must in be in foreground."
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0"
                                                       FontSize="11"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </GroupBox>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Display is always visible: the built-in default profile edits the GLOBAL
                             color settings here, and game profiles edit their foreground overrides. -->
                        <TabItem Header="Display">
                            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}"
                                          Padding="24,16,28,24">
                                <StackPanel>
                                    <GroupBox Padding="16" Margin="0,0,0,8"
                                              Visibility="{Binding IsCustomProfile, Converter={StaticResource VisibleIfTrue}}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Crosshair Overlay"
                                                          IsChecked="{Binding CrosshairEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Shows a centered crosshair overlay while profile is active."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding CrosshairEnabled}"
                                                    Tag="{Binding CrosshairEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <CheckBox Content="Hide while right mouse button is held"
                                                      IsChecked="{Binding CrosshairHideWhileRightButtonHeld}"
                                                      Margin="0,0,0,8" />
                                            <!-- Standard setting row (140 label / * control / Auto reset),
                                                 same as every other slider row in the editor: the slider
                                                 stretches to the card edge instead of a fixed width, and
                                                 the value readout uses the shared accent W60 style. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Crosshair Size"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Value="{Binding CrosshairSizeAdjustment, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="-50"
                                                            Maximum="50"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"
                                                            ToolTip="Scales the crosshair overlay from -50% to +50% relative to its source size (0 = original). The overlay stays centered and symmetrical while dragging." />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CrosshairSizeAdjustment, StringFormat={}{0:+0 '%';-0 '%';'0 %'}}"
                                                               VerticalAlignment="Center"
                                                               Width="60"
                                                               TextAlignment="Left"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Content="Reset"
                                                        Command="{Binding ResetCrosshairSizeCommand}"
                                                        Width="70"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                            <!-- Crosshair image is intentionally hardcoded to the bundled
                                                 default (Icons/Crosshair.png; an empty CrosshairImagePath
                                                 renders it). Planned: a preset dropdown with a custom-image
                                                 option. The picker row below is parked for that, and
                                                 ProfileViewModel.CrosshairImagePath,
                                                 MainViewModel.BrowseCrosshairImageCommand, and the INI
                                                 ImagePath key are kept so this UI drops back in as-is.
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Image"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding CrosshairImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Content="Browse…"
                                                        Command="{Binding DataContext.BrowseCrosshairImageCommand, ElementName=RootWindow}"
                                                        CommandParameter="{Binding}"
                                                        Margin="8,0,0,0"
                                                        Width="100" />
                                            </Grid>
                                            -->
                                        </StackPanel>
                                    </GroupBox>

                                <GroupBox Padding="16" Margin="0,0,0,8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal" MinHeight="22">
                                            <CheckBox Content="Color Profiles"
                                                      IsChecked="{Binding ColorSettings.IsEnabled}"
                                                      Margin="0"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource InfoIconStyle}"
                                                       ToolTip="Adjust display color settings. Application profiles apply only when the application is in foreground. Check individual monitors to enable adjustments."
                                                       ToolTipService.InitialShowDelay="0"
                                                       ToolTipService.Placement="Right" />
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ColorSettings.IsEnabled}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.75" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        
                                        <TextBlock Margin="0,0,0,12"
                                                   Foreground="{StaticResource ForegroundSecondaryBrush}">
                                            <Run Text="Toggle key: " />
                                            <Run Text="{Binding DataContext.ColorToggleKey, ElementName=RootWindow, Converter={StaticResource KeyDisplayConverter}, Mode=OneWay}" />
                                            <Run Text=" — assigned in Settings" />
                                        </TextBlock>

                                        <!-- Primary/Secondary color presets: edit one set of sliders at a time. -->
                                        <StackPanel Margin="0,0,0,12">
                                            <CheckBox Content="Enable a secondary color preset"
                                                      IsChecked="{Binding ColorSettings.HasSecondary}"
                                                      Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Edit preset"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <ToggleButton Grid.Column="1"
                                                              Style="{StaticResource PresetVariantToggleStyle}"
                                                              IsChecked="{Binding ColorSettings.IsEditingSecondary, Mode=TwoWay}"
                                                              IsEnabled="{Binding ColorSettings.CanEditSecondary}"
                                                              ToolTip="Choose which color profile to edit."
                                                              AutomationProperties.Name="Color preset to edit" />
                                            </Grid>
                                            <!-- Game profiles only (the default profile's colors are already
                                                 live): temporarily force-apply the edited profile's colors while tuning. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                        Visibility="{Binding IsCustomProfile, Converter={StaticResource VisibleIfTrue}}">
                                                <CheckBox Content="Force preview"
                                                          IsChecked="{Binding ColorSettings.IsForcePreviewEnabled}"
                                                          IsEnabled="{Binding ColorSettings.IsForcePreviewAvailable}"
                                                          VerticalAlignment="Center"
                                                          Margin="0" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Temporarily (30s) force activate color profile to faciliate live editing."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                                <TextBlock Text="{Binding ColorSettings.ForcePreviewCountdown}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Primary is the default look. Secondary is an optional alternate preset."
                                                       Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- No displays message -->
                                        <TextBlock Text="No displays detected."
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Visibility="{Binding ColorSettings.HasDisplays, Converter={StaticResource VisibleIfFalse}}"
                                                   Margin="0,0,0,8" />
                                        
                                        <!-- Per-monitor controls -->
                                        <ItemsControl ItemsSource="{Binding ColorSettings.DisplayViewModels}"
                                                      Visibility="{Binding ColorSettings.HasDisplays, Converter={StaticResource VisibleIfTrue}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Asymmetric padding: LEFT 4 keeps the slider
                                                         start lined up with the other tabs' rows (a
                                                         large left inset shortens the slider); RIGHT 12
                                                         floats the Reset buttons off the card border
                                                         instead of gluing them to its edge. -->
                                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="4,12,12,12"
                                                            Margin="0,0,0,12">
                                                        <StackPanel>
                                                            <!-- Monitor header with checkbox -->
                                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                                      Content="{Binding DisplayName}"
                                                                      FontWeight="SemiBold"
                                                                      Margin="0,0,0,12" />
                                                            
                                                            <!-- Sliders container - enabled when monitor checkbox is checked -->
                                                            <StackPanel IsEnabled="{Binding AreControlsEnabled}"
                                                                        Tag="{Binding AreControlsEnabled}"
                                                                        Style="{StaticResource FeatureToggleContentStyle}">
                                                                
                                                                <!-- Brightness -->
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Brightness" VerticalAlignment="Center" />
                                                                    <Grid Grid.Column="1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"
                                                                                Minimum="0"
                                                                                Maximum="100"
                                                                                TickFrequency="1"
                                                                                IsSnapToTickEnabled="True"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Brightness, StringFormat='{}{0}%'}"
                                                                                   VerticalAlignment="Center"
                                                                                   Width="60"
                                                                                   TextAlignment="Left"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Grid>
                                                                    <Button Grid.Column="2"
                                                                            Content="Reset"
                                                                            Command="{Binding ResetBrightnessCommand}"
                                                                            Width="70"
                                                                            HorizontalAlignment="Right" />
                                                                </Grid>

                                                                <!-- Contrast -->
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Contrast" VerticalAlignment="Center" />
                                                                    <Grid Grid.Column="1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}"
                                                                                Minimum="0"
                                                                                Maximum="100"
                                                                                TickFrequency="1"
                                                                                IsSnapToTickEnabled="True"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Contrast, StringFormat='{}{0}%'}"
                                                                                   VerticalAlignment="Center"
                                                                                   Width="60"
                                                                                   TextAlignment="Left"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Grid>
                                                                    <Button Grid.Column="2"
                                                                            Content="Reset"
                                                                            Command="{Binding ResetContrastCommand}"
                                                                            Width="70"
                                                                            HorizontalAlignment="Right" />
                                                                </Grid>

                                                                <!-- Gamma -->
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Gamma" VerticalAlignment="Center" />
                                                                    <Grid Grid.Column="1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider Value="{Binding Gamma, UpdateSourceTrigger=PropertyChanged}"
                                                                                Minimum="0.5"
                                                                                Maximum="3"
                                                                                TickFrequency="0.05"
                                                                                IsSnapToTickEnabled="True"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Gamma, StringFormat='{}{0:F2}'}"
                                                                                   VerticalAlignment="Center"
                                                                                   Width="60"
                                                                                   TextAlignment="Left"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Grid>
                                                                    <Button Grid.Column="2"
                                                                            Content="Reset"
                                                                            Command="{Binding ResetGammaCommand}"
                                                                            Width="70"
                                                                            HorizontalAlignment="Right" />
                                                                </Grid>

                                                                <!-- Digital Vibrance -->
                                                                <Grid Margin="0,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="Digital Vibrance" VerticalAlignment="Center" />
                                                                        <TextBlock Style="{StaticResource InfoIconStyle}"
                                                                                   ToolTip="Digital Vibrance is NVIDIA-only (requires NVIDIA GPU/drivers)."
                                                                                   ToolTipService.InitialShowDelay="0"
                                                                                   ToolTipService.Placement="Right" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider Value="{Binding DigitalVibrance, UpdateSourceTrigger=PropertyChanged}"
                                                                                Minimum="50"
                                                                                Maximum="100"
                                                                                TickFrequency="1"
                                                                                IsSnapToTickEnabled="True"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DigitalVibrance, StringFormat='{}{0}%'}"
                                                                                   VerticalAlignment="Center"
                                                                                   Width="60"
                                                                                   TextAlignment="Left"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Grid>
                                                                    <Button Grid.Column="2"
                                                                            Content="Reset"
                                                                            Command="{Binding ResetDigitalVibranceCommand}"
                                                                            Width="70"
                                                                            HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!-- System is always visible: Caps Lock applies to every profile kind.
                             (The built-in-only Windows Launcher group lives in its own Launcher
                             tab at the head of the strip.) -->
                        <TabItem Header="System">
                            <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}"
                                          Padding="24,16,28,24">
                                <StackPanel>
                                    <GroupBox Padding="16" Margin="0,0,0,8">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal" MinHeight="22">
                                                <CheckBox Content="Caps Lock"
                                                          IsChecked="{Binding CapsLockEnabled}"
                                                          Margin="0"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoIconStyle}"
                                                           ToolTip="Normal mirrors Caps Lock down/up. 2x Normal sends one full key press on Caps Lock down and another on release. Disabled suppresses the key. Remap Key substitutes the selected output key."
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.Placement="Right" />
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding CapsLockEnabled}"
                                                    Tag="{Binding CapsLockEnabled}"
                                                    Style="{StaticResource FeatureToggleContentStyle}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Mode" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource InfoIconStyle}"
                                                               ToolTip="Normal mirrors Caps Lock down/up. 2x Normal sends one full key press on Caps Lock down and another on release. Disabled suppresses the key entirely."
                                                               ToolTipService.InitialShowDelay="0"
                                                               ToolTipService.Placement="Right" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.CapsLockModes, ElementName=RootWindow}"
                                                          SelectedItem="{Binding CapsLockMode, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}"
                                                                                         Value="{x:Static models:CapsLockMode.DoubleNormal}">
                                                                                <Setter Property="Text" Value="2x Normal" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="Remap Key"
                                                          IsChecked="{Binding CapsLockRemapEnabled}"
                                                          IsEnabled="{Binding CanRemapCapsLock}"
                                                          VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          HorizontalAlignment="Left"
                                                          Width="180"
                                                          ItemsSource="{Binding DataContext.KeyOptionsWithNone, ElementName=RootWindow}"
                                                          SelectedItem="{Binding CapsLockRemapKey, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanSelectCapsLockRemapKey}"
                                                          behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                            </DockPanel>
                        </DockPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>

                </ContentControl>
        </Border>
        </Grid>

        <!-- Update-available overlay chip (card: no popup; dismissible; links to GitHub).
             Appended AFTER the content grid so it z-orders above it; local-attribute visibility
             binding + the VisibleIfTrue converter (the only mechanism proven reliable here). -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Padding="14,8"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource VisibleIfTrue}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           AutomationProperties.Name="Update available"/>
                <TextBlock Text="{Binding UpdateBannerText}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}">
                    <Hyperlink NavigateUri="{Binding UpdateDownloadUrl}"
                               Foreground="{DynamicResource AccentBrush}"
                               ToolTip="Opens the latest release page on GitHub in your browser."
                               RequestNavigate="UpdateLink_RequestNavigate">Download from GitHub</Hyperlink>
                </TextBlock>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="24" Height="24" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        Command="{Binding DismissUpdateBannerCommand}"
                        ToolTip="Dismiss update notification" ToolTipService.InitialShowDelay="0"
                        AutomationProperties.Name="Dismiss update notification"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>



