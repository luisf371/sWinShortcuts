<Window x:Class="sWinShortcuts.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:sWinShortcuts.Converters"
        xmlns:behaviors="clr-namespace:sWinShortcuts.Behaviors"
        Title="Settings" Width="380" Height="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundElevatedBrush}">
    <Window.Resources>
        <conv:KeyDisplayConverter x:Key="KeyDisplayConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical">
            <TextBlock Text="Startup"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <CheckBox x:Name="StartWithWindowsCheck"
                      Content="Start with Windows"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                      IsEnabled="{Binding CanEditStartup}"
                      Margin="0,0,0,8"
                      Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <CheckBox x:Name="StartAsAdminCheck"
                      Content="Start as administrator"
                      IsChecked="{Binding StartAsAdmin, Mode=TwoWay}"
                      IsEnabled="{Binding CanChooseAdmin}"
                      Margin="24,0,0,8"
                      Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <CheckBox x:Name="StartMinimizedCheck"
                      Content="Start minimized to tray"
                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                      IsEnabled="{Binding CanEditStartup}"
                      ToolTip="Hide the main window to the system tray when sWinShortcuts launches. The tray icon and all input features still work."
                      Margin="24,0,0,8"
                      Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <Separator Margin="0,8,0,8" Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="Hotkeys"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <!-- Title + dropdown share one line (vertically centered on each other); the
                 description sits underneath as a full-width caption. Centering the combo
                 against the old two-line label block parked it ~8px below the title. -->
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Color profile toggle key"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ColorToggleKeyOptions}"
                              SelectedItem="{Binding ColorToggleKey, Mode=TwoWay}"
                              behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True"
                              Width="132">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <TextBlock Text="Toggles between Primary and Secondary color profile."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Rapid-fire toggle key"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ColorToggleKeyOptions}"
                              SelectedItem="{Binding RapidFireToggleKey, Mode=TwoWay}"
                              behaviors:ComboBoxKeySelectionBehavior.EnableKeySelection="True"
                              Width="132">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <TextBlock Text="Toggles Rapid Fire for the current profile."
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Separator Margin="0,8,0,8" Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="Troubleshooting"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <CheckBox Content="Enable Debug Logging"
                      IsChecked="{Binding EnableDebugLogging, Mode=TwoWay}"
                      Margin="0,0,0,8"
                      Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <CheckBox Content="Hook-loss watchdog (auto-recover dead hooks)"
                      IsChecked="{Binding HookWatchdogEnabled, Mode=TwoWay}"
                      ToolTip="Detects Windows silently removing the input hooks and re-installs them. Disable only to rule it out while troubleshooting."
                      Margin="0,0,0,8"
                      Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

            <Separator Margin="0,8,0,8" Background="{DynamicResource BorderBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Advanced"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Orange"
                           ToolTip="&#x26A0; WARNING: Advanced Mode features can violate '1 key = 1 action' rules in competitive or anti-cheat restricted games. Use at your own risk."
                           ToolTipService.InitialShowDelay="0"
                           ToolTipService.Placement="Right"
                           AutomationProperties.Name="Advanced Mode warning" />
            </StackPanel>

            <CheckBox Content="Enable Advanced Mode"
                      IsChecked="{Binding AdvancedModeEnabled, Mode=TwoWay}"
                      ToolTip="Enables advance features (Auto-Run, Anti-AFK, Auto Hold-Breath, etc). Off = only game-safe 1:1 remaps."
                      ToolTipService.InitialShowDelay="0"
                      Foreground="{DynamicResource ForegroundPrimaryBrush}"
                      Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Build stamp: CI bakes the workflow run number into the exe (matches the "build-N"
             GitHub Release tag). "Build dev" = locally built, not from CI. -->
        <TextBlock x:Name="BuildLabel"
                   Grid.Row="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   FontSize="11"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                   ToolTip="CI build that produced this executable (matches the build-N GitHub release tag). 'Build dev' means a local build."
                   ToolTipService.InitialShowDelay="0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="80" Margin="0,0,8,0" MinHeight="28" IsCancel="True">Cancel</Button>
            <Button Width="80" Margin="0" MinHeight="28" IsDefault="True" IsEnabled="{Binding CanSave}" Click="OnSaveClick">Save</Button>
        </StackPanel>
    </Grid>
</Window>
