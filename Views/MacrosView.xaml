<UserControl x:Class="sWinShortcuts.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sWinShortcuts.ViewModels"
             xmlns:models="clr-namespace:sWinShortcuts.Models"
             xmlns:conv="clr-namespace:sWinShortcuts.Converters"
             xmlns:ctrl="clr-namespace:sWinShortcuts.Controls"
             x:Name="Editor" Unloaded="Editor_Unloaded" DataContextChanged="Editor_DataContextChanged"
             AutomationProperties.Name="Macro editor">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverterEx x:Key="VisibleIfTrue" />
        <conv:BooleanToVisibilityConverterEx x:Key="VisibleIfFalse" Invert="True" />
        <conv:KeyChordConverter x:Key="KeyChord" />

        <!-- App brushes are referenced with DynamicResource: template tests host this view without an
             Application. These local tones keep secondary text, selection and state colors at 4.5:1 or
             better on the dark panels. State is always repeated in text, never color alone. -->
        <SolidColorBrush x:Key="MacroMutedBrush" Color="#FF9AA4B2" />
        <SolidColorBrush x:Key="MacroDetailBrush" Color="#FFC5CDD8" />
        <SolidColorBrush x:Key="MacroSelectedTextBrush" Color="#FFD5DDE8" />
        <SolidColorBrush x:Key="MacroPanelBrush" Color="#FF121B26" />
        <SolidColorBrush x:Key="MacroLineBrush" Color="#FF243246" />
        <SolidColorBrush x:Key="MacroInputLineBrush" Color="#FF5A6B80" />
        <SolidColorBrush x:Key="MacroControlBrush" Color="#FF17212D" />
        <SolidColorBrush x:Key="MacroControlHoverBrush" Color="#FF1F2C3B" />
        <SolidColorBrush x:Key="MacroControlPressedBrush" Color="#FF16324A" />
        <SolidColorBrush x:Key="MacroRowHoverBrush" Color="#FF1A2533" />
        <SolidColorBrush x:Key="MacroRowSelectedBrush" Color="#FF1D4A6B" />
        <SolidColorBrush x:Key="MacroPrimaryBrush" Color="#FF2579AD" />
        <SolidColorBrush x:Key="MacroPrimaryHoverBrush" Color="#FF206A99" />
        <SolidColorBrush x:Key="MacroPrimaryPressedBrush" Color="#FF1A5A83" />
        <SolidColorBrush x:Key="MacroFocusBrush" Color="#FF65BDED" />
        <SolidColorBrush x:Key="MacroSuccessBrush" Color="#FF7CC99A" />
        <SolidColorBrush x:Key="MacroWarningBrush" Color="#FFE3B25B" />
        <SolidColorBrush x:Key="MacroErrorBrush" Color="#FFF08A7E" />
        <SolidColorBrush x:Key="MacroOffBrush" Color="#FF6B7686" />
        <SolidColorBrush x:Key="MacroRecordBrush" Color="#FFE5484D" />
        <SolidColorBrush x:Key="MacroRecordingSurfaceBrush" Color="#FF2A191C" />
        <SolidColorBrush x:Key="MacroRecordingLineBrush" Color="#FF6B2E35" />
        <SolidColorBrush x:Key="MacroNoticeSurfaceBrush" Color="#FF272216" />
        <SolidColorBrush x:Key="MacroNoticeLineBrush" Color="#FF5A4822" />
        <!-- The wait-time bar takes over the toolbar like the recording banner, in the accent hue instead of red.
             Times it would change read in MacroWaitTargetBrush: 5.6:1 even on a selected row. -->
        <SolidColorBrush x:Key="MacroTimingSurfaceBrush" Color="#FF0F2131" />
        <SolidColorBrush x:Key="MacroTimingLineBrush" Color="#FF22506F" />
        <SolidColorBrush x:Key="MacroWaitTargetBrush" Color="#FF8ED1F5" />

        <!-- 16 px stroke icons drawn in one weight by MacroIcon. -->
        <Geometry x:Key="MacroIconKeyboard">M2.5,4.5 H13.5 A1,1 0 0 1 14.5,5.5 V11.5 A1,1 0 0 1 13.5,12.5 H2.5 A1,1 0 0 1 1.5,11.5 V5.5 A1,1 0 0 1 2.5,4.5 Z M4.25,7 H4.75 M6.75,7 H7.25 M9.25,7 H9.75 M11.25,7 H11.75 M5,10 H11</Geometry>
        <Geometry x:Key="MacroIconMouse">M8,1.5 A4.5,4.5 0 0 1 12.5,6 V10 A4.5,4.5 0 0 1 3.5,10 V6 A4.5,4.5 0 0 1 8,1.5 Z M8,3.5 V6</Geometry>
        <Geometry x:Key="MacroIconWait">M1.75,8 A6.25,6.25 0 0 1 14.25,8 A6.25,6.25 0 0 1 1.75,8 Z M8,4.5 V8 L10.5,9.5</Geometry>
        <Geometry x:Key="MacroIconMove">M4.5,2 V13 L7.25,10.5 L9.25,14.25 L10.9,13.4 L8.9,9.75 H12.5 Z</Geometry>
        <Geometry x:Key="MacroIconWheel">M8,2 V14 M5,5 L8,2 L11,5 M5,11 L8,14 L11,11</Geometry>
        <Geometry x:Key="MacroIconAdd">M8,3 V13 M3,8 H13</Geometry>
        <Geometry x:Key="MacroIconChevron">M4,6 L8,10 L12,6</Geometry>
        <Geometry x:Key="MacroIconDuplicate">M5.5,5.5 H12.5 A1,1 0 0 1 13.5,6.5 V13.5 A1,1 0 0 1 12.5,14.5 H5.5 A1,1 0 0 1 4.5,13.5 V6.5 A1,1 0 0 1 5.5,5.5 Z M2.5,10.5 V3.5 A1,1 0 0 1 3.5,2.5 H10.5</Geometry>
        <Geometry x:Key="MacroIconDelete">M2.5,4.5 H13.5 M6,4.5 V3 A0.75,0.75 0 0 1 6.75,2.25 H9.25 A0.75,0.75 0 0 1 10,3 V4.5 M4,4.5 L4.75,13 A1,1 0 0 0 5.75,14 H10.25 A1,1 0 0 0 11.25,13 L12,4.5 M6.75,7 V11.5 M9.25,7 V11.5</Geometry>
        <Geometry x:Key="MacroIconUp">M8,13 V3 M4,7 L8,3 L12,7</Geometry>
        <Geometry x:Key="MacroIconDown">M8,3 V13 M4,9 L8,13 L12,9</Geometry>
        <Geometry x:Key="MacroIconTarget">M3,8 A5,5 0 0 1 13,8 A5,5 0 0 1 3,8 Z M8,1 V5 M8,11 V15 M1,8 H5 M11,8 H15</Geometry>
        <Geometry x:Key="MacroIconWarning">M8,1.75 L14.75,13.75 H1.25 Z M8,6 V9.25 M8,11.5 V11.75</Geometry>
        <Geometry x:Key="MacroIconPlay">M5,3.25 L12.75,8 L5,12.75 Z</Geometry>
        <Geometry x:Key="MacroIconMore">M3.5,8 L3.51,8 M8,8 L8.01,8 M12.5,8 L12.51,8</Geometry>
        <Geometry x:Key="MacroIconRename">M10.25,2.75 L13.25,5.75 L6,13 H3 V10 Z M8.75,4.25 L11.75,7.25</Geometry>
        <Geometry x:Key="MacroIconClear">M2.5,4.5 H13.5 M2.5,8 H9 M2.5,11.5 H7 M10.5,10 L13.5,13 M13.5,10 L10.5,13</Geometry>
        <Geometry x:Key="MacroIconCheck">M3,8.5 L6.5,12 L13,4.5</Geometry>

        <Style x:Key="MacroIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.25" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- Keyboard focus rings (shown only for keyboard navigation). -->
        <Style x:Key="MacroFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True"
                                BorderBrush="{StaticResource MacroFocusBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacroInsetFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="4,1" BorderThickness="2" CornerRadius="4" SnapsToDevicePixels="True"
                                BorderBrush="{StaticResource MacroFocusBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacroButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource MacroControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacroLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MacroFocusRing}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <!-- The app-wide TextBlock style would pin label text to one color; follow the button. -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroPrimaryButton" TargetType="Button" BasedOn="{StaticResource MacroButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacroPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacroPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroPrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacroFocusBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroPrimaryPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroIconButton" TargetType="Button" BasedOn="{StaticResource MacroButton}">
            <Setter Property="Foreground" Value="{StaticResource MacroDetailBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacroLineBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroControlPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MacroFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- How many rows a wait-time scope changes, beside its segment label: a light chip on the dark segments,
             a dark one on the checked accent segment so the white number stays above 4.5:1. -->
        <Style x:Key="MacroCountChip" TargetType="Border">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Background" Value="#40000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroFieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="56" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MacroMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MacroComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroRowSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroMenuSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource MacroLineBrush}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Own template: the theme ListBox turns white when disabled, which recording does. -->
        <Style x:Key="MacroStepList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource MacroPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacroLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MacroInsetFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroStepItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0}: {1}. {2} {3}">
                        <Binding Path="AutomationStepLabel" /><Binding Path="DisplayActionLabel" />
                        <Binding Path="Detail" /><Binding Path="DisplayTimingText" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MacroInsetFocusRing}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Margin="4,1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Screen readers hear a press group's open state with the row. -->
                <DataTrigger Binding="{Binding PressGroupPart}" Value="{x:Static vm:MacroPressGroupPart.ClosedHead}">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PressGroupPart}" Value="{x:Static vm:MacroPressGroupPart.OpenHead}">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Expanded" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroRowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacroRowSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Read-only field of a keybind capture box: the app's input look with the macro input line. -->
        <Style x:Key="MacroCaptureField" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacroInputLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Macro switcher entry: label, shortcut, and a state word whenever it cannot play as-is. -->
        <DataTemplate x:Key="MacroChoice" DataType="{x:Type vm:MacroViewModel}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource MacroSuccessBrush}" />
                <TextBlock Text="{Binding Label}" MaxWidth="200" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <TextBlock x:Name="Shortcut" Text="{Binding ShortcutText}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource MacroMutedBrush}" />
                <TextBlock x:Name="StateText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource MacroOffBrush}" />
                    <Setter TargetName="StateText" Property="Text" Value="Off" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource MacroMutedBrush}" />
                    <Setter TargetName="StateText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlayable}" Value="False">
                    <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource MacroWarningBrush}" />
                    <Setter TargetName="StateText" Property="Text" Value="Not ready" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource MacroWarningBrush}" />
                    <Setter TargetName="StateText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFormatError}" Value="True">
                    <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource MacroErrorBrush}" />
                    <Setter TargetName="StateText" Property="Text" Value="Not saved" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource MacroErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="True">
                    <Setter TargetName="Shortcut" Property="Foreground" Value="{StaticResource MacroSelectedTextBrush}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource MacroSelectedTextBrush}" />
                </DataTrigger>
                <!-- In the closed picker (no item container) the status beside it already says the state. -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue={x:Null}}" Value="{x:Null}">
                    <Setter TargetName="StateText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Step row: number, action category, action, target, and hold/wait time in a fixed column. -->
        <DataTemplate x:Key="MacroStepRow" DataType="{x:Type vm:MacroStepViewModel}">
            <Grid x:Name="Row" Background="Transparent" ToolTip="{Binding DisplayError}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <!-- A 1 px margin line marks the three rows of an open press group. -->
                <Border x:Name="OpenPressLine" Width="1" HorizontalAlignment="Left" Margin="2,-1,0,-1"
                        Background="{StaticResource MacroLineBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="Number" Text="{Binding DisplayNumber}" FontSize="12" TextAlignment="Right" Margin="0,0,10,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                <Button x:Name="PressToggle" Grid.Column="1" Focusable="False" Visibility="Collapsed" Padding="0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Command="{Binding DataContext.TogglePressGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Collapse press">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"><ContentPresenter /></Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Path x:Name="PressChevron" Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconChevron}"
                          Stroke="{StaticResource MacroMutedBrush}" RenderTransformOrigin="0.5,0.5" />
                </Button>
                <Path x:Name="Icon" Grid.Column="2" Style="{StaticResource MacroIcon}" HorizontalAlignment="Left"
                      Data="{StaticResource MacroIconKeyboard}" Stroke="{StaticResource MacroMutedBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding DisplayActionLabel}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource MacroDetailBrush}" />
                <Path x:Name="ErrorMark" Grid.Column="5" Style="{StaticResource MacroIcon}" Margin="0,0,4,0"
                      Data="{StaticResource MacroIconWarning}" Stroke="{StaticResource MacroErrorBrush}" />
                <TextBlock x:Name="Timing" Grid.Column="6" Text="{Binding DisplayTimingText}" FontSize="12" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MacroMutedBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PressGroupPart}" Value="{x:Static vm:MacroPressGroupPart.ClosedHead}">
                    <Setter TargetName="PressToggle" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PressToggle" Property="AutomationProperties.Name" Value="Expand press" />
                    <Setter TargetName="PressChevron" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding PressGroupPart}" Value="{x:Static vm:MacroPressGroupPart.OpenHead}">
                    <Setter TargetName="PressToggle" Property="Visibility" Value="Visible" />
                    <Setter TargetName="OpenPressLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PressGroupPart}" Value="{x:Static vm:MacroPressGroupPart.OpenMiddle}">
                    <Setter TargetName="OpenPressLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PressGroupPart}" Value="{x:Static vm:MacroPressGroupPart.OpenLast}">
                    <Setter TargetName="OpenPressLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasMouseButton}" Value="True">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconMouse}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MacroStepKind.Wait}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconWait}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMove}" Value="True">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconMove}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MacroStepKind.SavePosition}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconTarget}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWheel}" Value="True">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconWheel}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MacroStepKind.FreezeMouse}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconMouse}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MacroStepKind.UnfreezeMouse}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource MacroIconMouse}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayError}" Value="">
                    <Setter TargetName="ErrorMark" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Row" Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
                <!-- The macro's playback problem names this row: warning color, like the Not ready status. -->
                <DataTrigger Binding="{Binding IsProblemOnly}" Value="True">
                    <Setter TargetName="ErrorMark" Property="Stroke" Value="{StaticResource MacroWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Number" Property="Foreground" Value="{StaticResource MacroSelectedTextBrush}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource MacroSelectedTextBrush}" />
                    <Setter TargetName="Timing" Property="Foreground" Value="{StaticResource MacroSelectedTextBrush}" />
                </DataTrigger>
                <!-- After selection so it also marks the selected row: the open wait-time bar would change this time. -->
                <DataTrigger Binding="{Binding IsWaitTarget}" Value="True">
                    <Setter TargetName="Timing" Property="Foreground" Value="{StaticResource MacroWaitTargetBrush}" />
                    <Setter TargetName="Timing" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Conditions that stop playback or editing for the whole profile. They sit outside the
             section so they stay full-contrast while its body is shaded. -->
        <StackPanel Grid.Row="0">
            <Border Margin="0,0,0,10" Padding="10,6" CornerRadius="4" BorderThickness="1"
                    Background="{StaticResource MacroRecordingSurfaceBrush}" BorderBrush="{StaticResource MacroRecordingLineBrush}"
                    Visibility="{Binding HasLoadError, Converter={StaticResource VisibleIfTrue}}">
                <TextBlock Text="{Binding LoadError}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MacroErrorBrush}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Macro load error" />
            </Border>
            <Border Margin="0,0,0,10" Padding="10,6" CornerRadius="4" BorderThickness="1"
                    Background="{StaticResource MacroNoticeSurfaceBrush}" BorderBrush="{StaticResource MacroNoticeLineBrush}"
                    Visibility="{Binding DataContext.AdvancedModeEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfFalse}}">
                <DockPanel>
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconWarning}" Stroke="{StaticResource MacroWarningBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Macros won't play until Advanced Mode is on. Turn it on in Settings."
                               FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MacroWarningBrush}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Section box with the profile switch in its header, as on the other profile tabs. A disabled or
             read-only profile shades it like their pages (its controls are already disabled through CanEdit);
             a recording keeps full contrast so Stop recording stays clear. -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanEdit}" Value="False" />
                                <Condition Binding="{Binding IsRecording}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="0.6" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <GroupBox Padding="16">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal" MinHeight="22">
                    <CheckBox Content="Macros" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanEdit}" Margin="0" VerticalAlignment="Center"
                              AutomationProperties.Name="Enable macros for this profile" />
                    <TextBlock Style="{DynamicResource InfoIconStyle}"
                               ToolTip="Turns every macro shortcut in this profile on or off."
                               ToolTipService.InitialShowDelay="0"
                               ToolTipService.Placement="Right" />
                </StackPanel>
            </GroupBox.Header>
        <!-- Body. A disabled ancestor disables every child, so the switch above and Stop recording stay
             outside the three gated parts. Tag drives the host's feature-off shading. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <StackPanel IsEnabled="{Binding IsEnabled}" Tag="{Binding IsEnabled}" Style="{DynamicResource FeatureToggleContentStyle}">

        <!-- Row 1, which macro: the picker, its own switch and status, then New and the rarer commands under More.
             Two header rows instead of three leave the step list more height. -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <ComboBox ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedMacro}" IsEnabled="{Binding CanEdit}"
                          ItemTemplate="{StaticResource MacroChoice}" ItemContainerStyle="{StaticResource MacroComboItem}"
                          TextSearch.TextPath="Label" MinHeight="32" MaxDropDownHeight="360"
                          BorderBrush="{StaticResource MacroInputLineBrush}" FocusVisualStyle="{StaticResource MacroFocusRing}"
                          ToolTip="{Binding SelectedMacro.Label}" AutomationProperties.Name="Selected macro" />
                <TextBlock Text="No macros yet" Margin="10,0,28,0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource MacroMutedBrush}"
                           Visibility="{Binding HasSelection, Converter={StaticResource VisibleIfFalse}}" />
            </Grid>
            <!-- The selected macro's own switch and whether it can play. The words stay short; the tooltip, and the
                 named step for a step problem, carry the full sentence. -->
            <DockPanel Grid.Column="1" Margin="12,0,10,0" DataContext="{Binding SelectedMacro}" IsEnabled="{Binding CanEdit}"
                       Visibility="{Binding DataContext.HasSelection, ElementName=Editor, Converter={StaticResource VisibleIfTrue}}">
                <CheckBox Content="On" IsChecked="{Binding IsEnabled}" Margin="0,0,14,0" VerticalAlignment="Center"
                          ToolTip="Only macros that are on respond to their shortcut."
                          AutomationProperties.Name="Enable selected macro" />
                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=MacroStatus}" />
                <!-- A step problem is fixed on that step: the link leads there and the step shows the full message. -->
                <Button DockPanel.Dock="Left" Style="{StaticResource MacroLinkButton}" Command="{Binding ShowProblemStepCommand}"
                        Content="{Binding ProblemStepNumber}" ContentStringFormat="Fix step {0}" VerticalAlignment="Center"
                        ToolTip="{Binding ValidationMessage}"
                        Visibility="{Binding HasProblemStep, Converter={StaticResource VisibleIfTrue}}"
                        AutomationProperties.Name="Show the step named in the message" />
                <TextBlock x:Name="MacroStatus" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MacroSuccessBrush}" />
                            <Setter Property="Text" Value="Ready" />
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip Content="{Binding ShortcutText}" ContentStringFormat="Press {0} while this profile is active." />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Later triggers win, so off and validation messages replace the ready copy. -->
                                <DataTrigger Binding="{Binding ToggleMode}" Value="True">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Content="{Binding ShortcutText}" ContentStringFormat="Press {0} to loop; press it again to stop." />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsEnabled, ElementName=Editor}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource MacroWarningBrush}" />
                                    <Setter Property="Text" Value="Macros are off" />
                                    <Setter Property="ToolTip" Value="Ready, but macros are off for this profile. Turn on Macros above." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource MacroMutedBrush}" />
                                    <Setter Property="Text" Value="Off" />
                                    <Setter Property="ToolTip" Value="Turn on On to use the shortcut." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlayable}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource MacroWarningBrush}" />
                                    <Setter Property="Text" Value="{Binding ValidationMessage}" />
                                    <Setter Property="ToolTip" Value="{Binding ValidationMessage}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFormatError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MacroErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasProblemStep}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
            <Button Grid.Column="2" Style="{StaticResource MacroButton}" Command="{Binding NewMacroCommand}" Margin="0,0,6,0"
                    ToolTip="Name and create a macro in this profile. A profile holds up to 64 macros."
                    AutomationProperties.Name="New macro">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconAdd}" Margin="0,0,6,0" />
                    <TextBlock Text="New…" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Rarer commands for the selected macro. Names change only through the naming dialog, so an unaccepted
                 name never reaches the macro; Clear and Delete ask first. -->
            <Button Grid.Column="3" x:Name="MoreButton" Style="{StaticResource MacroIconButton}" Click="MenuButton_Click"
                    ToolTip="Rename, duplicate, share, clear, or delete this macro, or import one"
                    AutomationProperties.Name="More macro commands">
                <Button.ContextMenu>
                    <ContextMenu MinWidth="190" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 ItemContainerStyle="{DynamicResource MacroContextMenuItemStyle}">
                        <MenuItem Header="Rename…" Command="{Binding RenameMacroCommand}" AutomationProperties.Name="Rename macro">
                            <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconRename}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Duplicate" Command="{Binding DuplicateMacroCommand}" AutomationProperties.Name="Duplicate macro"
                                  ToolTip="The copy starts off, without a shortcut.">
                            <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconDuplicate}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource MacroMenuSeparator}" />
                        <!-- One tooltip covers both states, so it also explains a disabled item. -->
                        <MenuItem Header="Export to clipboard" Command="{Binding ExportMacroCommand}" AutomationProperties.Name="Export macro to clipboard"
                                  ToolTip="Copy this macro as a share code. Fix any highlighted fields first."
                                  ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconUp}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Import from clipboard" Command="{Binding ImportMacroCommand}" AutomationProperties.Name="Import macro from clipboard"
                                  ToolTip="Add a macro from a code on the clipboard. A profile holds up to 64 macros."
                                  ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconDown}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource MacroMenuSeparator}" />
                        <MenuItem Header="Clear all steps…" Command="{Binding ClearStepsCommand}" AutomationProperties.Name="Clear all steps"
                                  ToolTip="Remove every step, for example to record it again. The name, shortcut, and options stay.">
                            <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconClear}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete macro…" Command="{Binding DeleteMacroCommand}" AutomationProperties.Name="Delete macro">
                            <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconDelete}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconMore}" StrokeThickness="2.25" />
            </Button>
        </Grid>

        <!-- Row 2, when and how it runs: the shortcut, then the playback choices in one menu whose button says what is
             set. The wider gap below closes the macro's header before the sequence. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" DataContext="{Binding SelectedMacro}" IsEnabled="{Binding CanEdit}"
                    Visibility="{Binding DataContext.HasSelection, ElementName=Editor, Converter={StaticResource VisibleIfTrue}}">
            <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconKeyboard}" Stroke="{StaticResource MacroMutedBrush}" Margin="2,0,10,0"
                  ToolTip="Shortcut: click Assign, then hold any modifiers and press a key or mouse button. F12 stops playback." />
            <ctrl:KeyCaptureBox Width="300" Mode="Combo" AcceptsMouseButtons="True" AcceptsLeftButton="True" AllowNone="True"
                                NoneText="No shortcut" Chord="{Binding Shortcut, Mode=TwoWay}"
                                Validator="{x:Static vm:MacroViewModel.ShortcutValidator}"
                                BoxStyle="{StaticResource MacroCaptureField}" ButtonStyle="{StaticResource MacroButton}"
                                ToolTip="Click Assign, then press the shortcut (keys or a mouse button over the box). Modifiers always come first. The matching shortcut is consumed."
                                AutomationName="Macro shortcut"
                                AutomationProperties.HelpText="Click Assign, then press the shortcut: Ctrl, Alt, Shift or Win plus a keyboard key, or one of the five mouse buttons over the box." />
            <Button x:Name="PlaybackButton" Style="{StaticResource MacroButton}" Margin="12,0,0,0" Click="MenuButton_Click"
                    ToolTip="How the shortcut plays this macro" AutomationProperties.Name="Playback options">
                <Button.ContextMenu>
                    <ContextMenu MinWidth="230" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 ItemContainerStyle="{DynamicResource MacroContextMenuItemStyle}">
                        <MenuItem Header="Play once per press" IsCheckable="True" IsChecked="{Binding PlaysOnce}"
                                  AutomationProperties.Name="Play once per press" />
                        <MenuItem Header="Loop until pressed again" IsCheckable="True" IsChecked="{Binding PlaysInLoop}"
                                  ToolTip="Press the shortcut to repeat this macro; press it again to stop, even mid-step."
                                  AutomationProperties.Name="Toggle loop" />
                        <Separator Style="{StaticResource MacroMenuSeparator}" />
                        <MenuItem Header="Start when released" IsCheckable="True" IsChecked="{Binding StartsWhenReleased}"
                                  ToolTip="Playback waits until the shortcut and its modifiers are released."
                                  AutomationProperties.Name="Start on release" />
                        <MenuItem Header="Start when pressed" IsCheckable="True" IsChecked="{Binding StartsWhenPressed}"
                                  ToolTip="Shift or Ctrl held for the shortcut stays held, so the app sees it with the macro's keys (Shift+Tab, for example). Alt and Win still have to be released first, because keys sent with them trigger Windows shortcuts."
                                  AutomationProperties.Name="Start on press" />
                        <Separator Style="{StaticResource MacroMenuSeparator}" />
                        <MenuItem Header="Stop when the mouse moves" IsCheckable="True" IsChecked="{Binding CancelOnMouseMovement}"
                                  AutomationProperties.Name="Cancel on mouse movement" />
                        <MenuItem Header="Show steps being played" IsCheckable="True" IsChecked="{Binding ShowPlayingSteps}"
                                  ToolTip="Shows the step being played in a small badge beside the cursor while this macro runs."
                                  AutomationProperties.Name="Show steps being played" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconPlay}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding PlaybackSummary}" VerticalAlignment="Center" />
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconChevron}" Margin="4,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
        </StackPanel>

        <!-- Sequence commands; while recording the same row becomes the recording banner, and while wait times are
             open it becomes their bar. Only the commands and the bar are gated: the banner keeps Stop recording
             reachable while the section is off. -->
        <Grid Grid.Row="1" Margin="0,0,0,8" MinHeight="32" Visibility="{Binding HasSelection, Converter={StaticResource VisibleIfTrue}}">
            <Grid DataContext="{Binding SelectedMacro}"
                  IsEnabled="{Binding DataContext.IsEnabled, ElementName=Editor}" Tag="{Binding DataContext.IsEnabled, ElementName=Editor}"
                  Style="{DynamicResource FeatureToggleContentStyle}"
                  Visibility="{Binding DataContext.IsRecording, ElementName=Editor, Converter={StaticResource VisibleIfFalse}}">
            <DockPanel Visibility="{Binding IsWaitEditorOpen, Converter={StaticResource VisibleIfFalse}}">
                <Button Style="{StaticResource MacroButton}" Command="{Binding DataContext.RecordCommand, ElementName=Editor}" Margin="0,0,6,0"
                        ToolTip="Record keys, mouse buttons and wheel input. Capture starts once this profile's app is in front, so switching to it is not recorded. The take goes where New steps go shows."
                        AutomationProperties.Name="Record macro">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource MacroRecordBrush}" />
                        <TextBlock Text="Record" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddStepButton" Style="{StaticResource MacroButton}" IsEnabled="{Binding CanAddStep}" Click="MenuButton_Click"
                        Margin="0,0,6,0" ToolTip="Choose an action to insert after the selected step."
                        AutomationProperties.Name="Add step">
                    <Button.ContextMenu>
                        <ContextMenu MinWidth="180" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     ItemContainerStyle="{DynamicResource MacroContextMenuItemStyle}">
                            <MenuItem Header="Key press" CommandParameter="{x:Static models:MacroStepKind.KeyPress}" Command="{Binding AddStepCommand}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Adds Key down, a 50 ms hold and Key up as one step. Needs 3 free steps. Macros hold up to 1,000.">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconKeyboard}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mouse click" CommandParameter="{x:Static models:MacroStepKind.MouseClick}" Command="{Binding AddStepCommand}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Adds Mouse down, a 50 ms hold and Mouse up as one step. Needs 3 free steps. Macros hold up to 1,000.">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconMouse}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MacroMenuSeparator}" />
                            <MenuItem Header="Move" CommandParameter="{x:Static models:MacroStepKind.MoveTo}" Command="{Binding AddStepCommand}">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconMove}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save position" CommandParameter="{x:Static models:MacroStepKind.SavePosition}" Command="{Binding AddStepCommand}">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconTarget}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mouse wheel" CommandParameter="{x:Static models:MacroStepKind.MouseWheel}" Command="{Binding AddStepCommand}">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconWheel}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MacroMenuSeparator}" />
                            <MenuItem Header="Freeze mouse" CommandParameter="{x:Static models:MacroStepKind.FreezeMouse}" Command="{Binding AddStepCommand}">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconMouse}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Unfreeze mouse" CommandParameter="{x:Static models:MacroStepKind.UnfreezeMouse}" Command="{Binding AddStepCommand}">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconMouse}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MacroMenuSeparator}" />
                            <MenuItem Header="Wait" CommandParameter="{x:Static models:MacroStepKind.Wait}" Command="{Binding AddStepCommand}">
                                <MenuItem.Icon><Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconWait}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconAdd}" Margin="0,0,6,0" />
                        <TextBlock Text="Add step" VerticalAlignment="Center" />
                        <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconChevron}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="WaitEditorButton" Style="{StaticResource MacroButton}" Margin="0,0,10,0"
                        Command="{Binding ShowWaitEditorCommand}" Click="WaitEditorOpen_Click"
                        ToolTip="Set press holds, Wait steps between actions, or both to one time. Unavailable when the macro has neither."
                        AutomationProperties.Name="Set wait times">
                    <StackPanel Orientation="Horizontal">
                        <!-- Accent like the bar it opens, as Record's red dot matches its banner. -->
                        <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconWait}" Stroke="{StaticResource MacroFocusBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Wait times…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="0,6,8,6" Fill="{StaticResource MacroLineBrush}" />
                <Button Style="{StaticResource MacroIconButton}" Command="{Binding DuplicateStepCommand}" Margin="0,0,2,0"
                        ToolTip="Duplicate step (Ctrl+D)" AutomationProperties.Name="Duplicate macro step">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconDuplicate}" />
                </Button>
                <Button Style="{StaticResource MacroIconButton}" Command="{Binding DeleteStepCommand}" Margin="0,0,2,0"
                        ToolTip="Delete step (Delete)" AutomationProperties.Name="Delete macro step">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconDelete}" />
                </Button>
                <Button Style="{StaticResource MacroIconButton}" Command="{Binding MoveStepUpCommand}" Margin="0,0,2,0"
                        ToolTip="Move step up (Alt+Up)" AutomationProperties.Name="Move step up">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconUp}" />
                </Button>
                <Button Style="{StaticResource MacroIconButton}" Command="{Binding MoveStepDownCommand}"
                        ToolTip="Move step down (Alt+Down)" AutomationProperties.Name="Move step down">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconDown}" />
                </Button>
                <!-- The rest of the row: where new steps go, or the live session while one runs. -->
                <Grid Margin="12,0,0,0">
                    <TextBlock Text="{Binding InsertionHint, StringFormat='New steps go {0}'}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource MacroMutedBrush}"
                               ToolTip="Add step and Record insert here. Select a step to insert after it.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SessionStatus, ElementName=Editor}" Value="Idle">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel HorizontalAlignment="Right">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SessionStatus, ElementName=Editor}" Value="Idle">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Right" Text=" · F12 cancels" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource MacroMutedBrush}"
                                   Visibility="{Binding DataContext.IsPlaying, ElementName=Editor, Converter={StaticResource VisibleIfTrue}}" />
                        <TextBlock Text="{Binding DataContext.SessionStatus, ElementName=Editor}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource MacroDetailBrush}"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Grid>
            </DockPanel>

            <!-- Wait times, in one row: the segment counts say what each scope changes and the list highlights those
                 rows, so nothing needs a second line. Same height as the commands, so the list never moves. -->
            <!-- The shaded bar ends at Close; the status sits after it on the row's background. -->
            <Grid Visibility="{Binding IsWaitEditorOpen, Converter={StaticResource VisibleIfTrue}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <Border Padding="0,1,2,1" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource MacroTimingSurfaceBrush}" BorderBrush="{StaticResource MacroTimingLineBrush}"
                    PreviewKeyDown="WaitEditor_PreviewKeyDown" AutomationProperties.Name="Wait time editor">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconWait}" Stroke="{StaticResource MacroFocusBrush}" Margin="8,0,7,0" />
                    <!-- The app's segmented picker, as on the Display tab. A scope with nothing to change is unavailable. -->
                    <Border Grid.Column="1" Padding="2" CornerRadius="4" BorderThickness="1" TextElement.FontSize="12"
                            Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{StaticResource MacroTimingLineBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton IsChecked="{Binding IsPressHoldScope}" IsEnabled="{Binding HasPressHolds}" Padding="7,3"
                                         Style="{DynamicResource SegmentRadioButtonStyle}" ToolTipService.ShowOnDisabled="True"
                                         ToolTip="How long each key or button is held: the Wait inside a press, plus Key press and Mouse click holds."
                                         AutomationProperties.Name="Change press holds">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Press holds" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource MacroCountChip}">
                                        <TextBlock Text="{Binding PressHoldCount}" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding IsBetweenStepsScope}" IsEnabled="{Binding HasBetweenWaits}" Padding="7,3"
                                         Style="{DynamicResource SegmentRadioButtonStyle}" ToolTipService.ShowOnDisabled="True"
                                         ToolTip="Wait steps that pause between actions."
                                         AutomationProperties.Name="Change Wait steps between actions">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Between steps" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource MacroCountChip}">
                                        <TextBlock Text="{Binding BetweenWaitCount}" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding IsAllWaitsScope}" Padding="7,3" Style="{DynamicResource SegmentRadioButtonStyle}"
                                         ToolTip="Press holds and Wait steps between actions."
                                         AutomationProperties.Name="Change press holds and Wait steps">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="All" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource MacroCountChip}">
                                        <TextBlock Text="{Binding AllWaitCount}" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <!-- Field and unit read as one input; its border carries focus and errors (no separate adorner). -->
                    <Border Grid.Column="2" Width="80" Margin="8,0,0,0" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource ComboBoxBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource MacroInputLineBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource MacroFocusBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding HasWaitEditError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource MacroErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="ms" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MacroMutedBrush}" />
                            <TextBox x:Name="WaitDurationField" BorderThickness="0" Background="Transparent" Padding="6,0,2,0"
                                     VerticalContentAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                                     Text="{Binding WaitDurationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     ToolTip="Whole milliseconds from 0 to 3600000. Enter applies; Esc closes."
                                     AutomationProperties.Name="Wait time in milliseconds" />
                        </DockPanel>
                    </Border>
                    <Button Grid.Column="3" Content="Apply" Style="{StaticResource MacroPrimaryButton}" MinHeight="28" Margin="8,0,0,0"
                            Command="{Binding ApplyWaitTimesCommand}" Click="WaitEditorApply_Click"
                            ToolTip="Set every highlighted time to this value (Enter)." AutomationProperties.Name="Apply wait time" />
                    <Button Grid.Column="4" Content="Close" Style="{StaticResource MacroButton}" MinHeight="28" Margin="6,0,0,0"
                            Command="{Binding CloseWaitEditorCommand}" Click="WaitEditorClose_Click"
                            ToolTip="Close (Esc)" AutomationProperties.Name="Close wait time editor" />
                </Grid>
            </Border>
                    <!-- The result only; an icon repeats success and errors beside the color. -->
                    <DockPanel Grid.Column="1" Margin="10,0,8,0">
                        <Path DockPanel.Dock="Left" Margin="0,0,6,0">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource MacroIcon}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WaitEditApplied}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Data" Value="{StaticResource MacroIconCheck}" />
                                            <Setter Property="Stroke" Value="{StaticResource MacroSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWaitEditError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Data" Value="{StaticResource MacroIconWarning}" />
                                            <Setter Property="Stroke" Value="{StaticResource MacroErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding WaitEditMessage}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Wait time edit status">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MacroDetailBrush}" />
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Style.Triggers>
                                        <!-- No status until Apply or an error; an empty tooltip would still pop up. -->
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="ToolTip" Value="{x:Null}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasWaitEditError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource MacroErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WaitEditApplied}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource MacroSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
            </Grid>
            </Grid>

            <Border Padding="10,0,0,0" CornerRadius="4" BorderThickness="1"
                    Background="{StaticResource MacroRecordingSurfaceBrush}" BorderBrush="{StaticResource MacroRecordingLineBrush}"
                    Visibility="{Binding IsRecording, Converter={StaticResource VisibleIfTrue}}">
                <DockPanel>
                    <Button x:Name="StopRecordingButton" DockPanel.Dock="Right" Style="{StaticResource MacroPrimaryButton}"
                            Command="{Binding StopRecordingCommand}"
                            PreviewMouseLeftButtonDown="StopRecording_PreviewMouseLeftButtonDown"
                            PreviewKeyDown="StopRecording_PreviewKeyDown"
                            ToolTip="Finish recording and insert the take. F12 also stops."
                            AutomationProperties.Name="Stop recording">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Margin="0,0,7,0" VerticalAlignment="Center"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Stop recording" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource MacroRecordBrush}" />
                    <TextBlock FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite">
                        <Run Text="{Binding SessionStatus, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundPrimaryBrush}" /><Run Text=" · New steps go " Foreground="{StaticResource MacroMutedBrush}" /><Run Text="{Binding SelectedMacro.InsertionHint, Mode=OneWay}" Foreground="{StaticResource MacroMutedBrush}" /><Run Text=" · F12 also stops" Foreground="{StaticResource MacroMutedBrush}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Workspace: the ordered sequence and the editor for the selected step. -->
        <Grid Grid.Row="2" IsEnabled="{Binding IsEnabled}" Tag="{Binding IsEnabled}" Style="{DynamicResource FeatureToggleContentStyle}">
        <Grid DataContext="{Binding SelectedMacro}"
              Visibility="{Binding DataContext.HasSelection, ElementName=Editor, Converter={StaticResource VisibleIfTrue}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="236" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="6" BorderThickness="1" IsEnabled="{Binding CanEdit}"
                    Background="{StaticResource MacroPanelBrush}" BorderBrush="{StaticResource MacroLineBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="10,4,6,4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource MacroLineBrush}">
                        <DockPanel>
                            <!-- Open or close every Down, Wait, Up press group. Display only. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Expand all" Style="{StaticResource MacroLinkButton}" FontSize="12" Margin="0,0,8,0"
                                        Command="{Binding ExpandAllCommand}" ToolTip="Show the Down, Wait and Up steps of every press."
                                        AutomationProperties.Name="Expand all presses" />
                                <Button Content="Collapse all" Style="{StaticResource MacroLinkButton}" FontSize="12"
                                        Command="{Binding CollapseAllCommand}" ToolTip="Show every press as one step."
                                        AutomationProperties.Name="Collapse all presses" />
                            </StackPanel>
                            <TextBlock Text="{Binding StepCountText}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MacroMutedBrush}" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="StepList" ItemsSource="{Binding VisibleSteps}" SelectedItem="{Binding SelectedStep}"
                                 Style="{StaticResource MacroStepList}" ItemContainerStyle="{StaticResource MacroStepItem}" ItemTemplate="{StaticResource MacroStepRow}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="StepList_SelectionChanged" PreviewKeyDown="StepList_PreviewKeyDown"
                                 AutomationProperties.Name="Ordered macro steps"
                                 AutomationProperties.HelpText="Delete removes the selected step, Ctrl+D duplicates it, and Alt+Up or Alt+Down moves it. Right opens a press and Left closes it." />
                        <StackPanel MaxWidth="300" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Steps.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No steps yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                            <TextBlock Text="Record your input, or use Add step to build the sequence one action at a time."
                                       FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" IsEnabled="{Binding CanEdit}"
                    Background="{StaticResource MacroPanelBrush}" BorderBrush="{StaticResource MacroLineBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="12,10,12,12">
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No step selected" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                            <TextBlock Text="Select a step to edit its action, target, and timing here." FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource MacroMutedBrush}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedStep.IsCollapsedPress, Converter={StaticResource VisibleIfTrue}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedStep.DisplayNumber, StringFormat='Steps {0}'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                                <TextBlock Text="{Binding Steps.Count, StringFormat='of {0}'}" FontSize="12" Margin="6,0,0,1" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource MacroMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Action" Style="{StaticResource MacroFieldLabel}" />
                                <TextBlock Text="{Binding SelectedStep.DisplayActionLabel}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding SelectedStep.HasKey, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="Key" Style="{StaticResource MacroFieldLabel}" />
                                <ctrl:KeyCaptureBox Width="134" Chord="{Binding SelectedPressKey, Converter={StaticResource KeyChord}, Mode=TwoWay}"
                                                    Validator="{x:Static vm:MacroViewModel.KeyValidator}" AcceptsEscape="True"
                                                    BoxStyle="{StaticResource MacroCaptureField}" ButtonStyle="{StaticResource MacroButton}"
                                                    AutomationName="Press key" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding SelectedStep.HasMouseButton, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="Button" Style="{StaticResource MacroFieldLabel}" />
                                <ComboBox Width="134" MinHeight="30" ItemsSource="{x:Static vm:MacroViewModel.MouseButtonOptions}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SelectedPressMouseButton}"
                                          ItemContainerStyle="{StaticResource MacroComboItem}"
                                          BorderBrush="{StaticResource MacroInputLineBrush}" FocusVisualStyle="{StaticResource MacroFocusRing}"
                                          AutomationProperties.Name="Press mouse button" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Hold" Style="{StaticResource MacroFieldLabel}" />
                                <TextBox Width="96" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                         Text="{Binding SelectedStep.CollapsedWait.DurationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         AutomationProperties.Name="Press hold in milliseconds" />
                                <TextBlock Text="ms" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedStep.DisplayError}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MacroErrorBrush}" AutomationProperties.LiveSetting="Polite" />
                            <Border Height="1" Margin="0,10,0,10" Background="{StaticResource MacroLineBrush}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource MacroMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Key down, Wait and Key up, shown as one step." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStep.HasMouseButton}" Value="True">
                                                <Setter Property="Text" Value="Mouse down, Wait and Mouse up where the cursor is. Add a Move before it to click somewhere specific." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Opening hides this panel with the focused link, so the click moves focus to the group's Down row. -->
                            <Button Content="Show the 3 steps" Style="{StaticResource MacroLinkButton}" HorizontalAlignment="Left"
                                    Command="{Binding ExpandSelectedStepCommand}" Click="ShowPressSteps_Click"
                                    AutomationProperties.Name="Expand press" />
                        </StackPanel>

                        <StackPanel DataContext="{Binding SelectedStep}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCollapsedPress}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Number, StringFormat='Step {0}'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                                <TextBlock Text="{Binding DataContext.SelectedMacro.Steps.Count, ElementName=Editor, StringFormat='of {0}'}"
                                           FontSize="12" Margin="6,0,0,1" VerticalAlignment="Bottom" Foreground="{StaticResource MacroMutedBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Action" Style="{StaticResource MacroFieldLabel}" />
                                <ComboBox Width="134" MinHeight="30" ItemsSource="{x:Static vm:MacroViewModel.ActionOptions}" DisplayMemberPath="Value"
                                          SelectedValuePath="Key" SelectedValue="{Binding ActionChoice}" ItemContainerStyle="{StaticResource MacroComboItem}"
                                          BorderBrush="{StaticResource MacroInputLineBrush}" FocusVisualStyle="{StaticResource MacroFocusRing}"
                                          AutomationProperties.Name="Step action" />
                            </StackPanel>
                            <Border HorizontalAlignment="Left" Margin="0,0,0,8" Padding="2" CornerRadius="4" BorderThickness="1" TextElement.FontSize="12"
                                    Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{StaticResource MacroLineBrush}"
                                    Visibility="{Binding IsMove, Converter={StaticResource VisibleIfTrue}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Position" IsChecked="{Binding MoveIsPosition}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                 AutomationProperties.Name="Move to a screen position" />
                                    <RadioButton Content="Offset" IsChecked="{Binding MoveIsOffset}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                 AutomationProperties.Name="Move by an offset" />
                                    <RadioButton Content="Saved" IsChecked="{Binding MoveIsSaved}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                 AutomationProperties.Name="Move to a saved position" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasKey, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="Key" Style="{StaticResource MacroFieldLabel}" />
                                <ctrl:KeyCaptureBox Width="134" Chord="{Binding Key, Converter={StaticResource KeyChord}, Mode=TwoWay}"
                                                    Validator="{x:Static vm:MacroViewModel.KeyValidator}" AcceptsEscape="True"
                                                    BoxStyle="{StaticResource MacroCaptureField}" ButtonStyle="{StaticResource MacroButton}"
                                                    AutomationName="Step key" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasMouseButton, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="Button" Style="{StaticResource MacroFieldLabel}" />
                                <ComboBox Width="134" MinHeight="30" ItemsSource="{x:Static vm:MacroViewModel.MouseButtonOptions}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MouseButton}"
                                          ItemContainerStyle="{StaticResource MacroComboItem}" BorderBrush="{StaticResource MacroInputLineBrush}"
                                          FocusVisualStyle="{StaticResource MacroFocusRing}" AutomationProperties.Name="Step mouse button" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasSlot, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="Saved position" Style="{StaticResource MacroFieldLabel}" TextWrapping="Wrap" />
                                <ComboBox Width="134" MinHeight="30" ItemsSource="{x:Static vm:MacroStepViewModel.SlotOptions}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Slot}"
                                          ItemContainerStyle="{StaticResource MacroComboItem}" BorderBrush="{StaticResource MacroInputLineBrush}"
                                          FocusVisualStyle="{StaticResource MacroFocusRing}" AutomationProperties.Name="Saved position number" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasOffset, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="Offset" Style="{StaticResource MacroFieldLabel}"
                                           ToolTip="Distance from the current position. Positive X moves right, positive Y moves down. Choose Pixels for an exact screen distance or Raw for mouse movement." />
                                <TextBlock Text="X" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                                <TextBox Width="56" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                         Text="{Binding XText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         AutomationProperties.Name="X offset" />
                                <TextBlock Text="Y" FontSize="12" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                                <TextBox Width="56" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                         Text="{Binding YText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         AutomationProperties.Name="Y offset" />
                            </StackPanel>
                            <!-- Pixels | Raw reads as the unit of the offset above it; Measure shares the row so the picker-sized
                                 inspector still fits at the minimum window size. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasOffset, Converter={StaticResource VisibleIfTrue}}">
                                <Border HorizontalAlignment="Left" Padding="2" CornerRadius="4" BorderThickness="1" TextElement.FontSize="12"
                                        Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{StaticResource MacroLineBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Pixels" IsChecked="{Binding MoveAsPixels}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     ToolTip="Exact screen pixels, checked on arrival."
                                                     AutomationProperties.Name="Move by exact pixels" />
                                        <RadioButton Content="Raw" IsChecked="{Binding MoveAsRaw}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     ToolTip="Real mouse movement for game cameras. Distance depends on sensitivity."
                                                     AutomationProperties.Name="Move with raw mouse movement" />
                                    </StackPanel>
                                </Border>
                                <Button Content="Measure" Style="{StaticResource MacroButton}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.SelectedMacro.MeasureOffsetCommand, ElementName=Editor}"
                                        Visibility="{Binding DataContext.SelectedMacro.IsCapturingCoordinates, ElementName=Editor, Converter={StaticResource VisibleIfFalse}}"
                                        ToolTip="Move to the start point within 3 seconds, then click where the move should end. Esc cancels."
                                        AutomationProperties.Name="Measure offset" />
                                <Button Content="Cancel" Style="{StaticResource MacroButton}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.SelectedMacro.CancelCoordinatePickCommand, ElementName=Editor}"
                                        Visibility="{Binding DataContext.SelectedMacro.IsCapturingCoordinates, ElementName=Editor, Converter={StaticResource VisibleIfTrue}}"
                                        AutomationProperties.Name="Cancel coordinate pick" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasCoordinates, Converter={StaticResource VisibleIfTrue}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Position" Style="{StaticResource MacroFieldLabel}"
                                               ToolTip="Absolute physical screen pixels. Displays left of or above the main display use negative values." />
                                    <TextBlock Text="X" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                                    <TextBox Width="56" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                             Text="{Binding XText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             AutomationProperties.Name="Screen X coordinate" />
                                    <TextBlock Text="Y" FontSize="12" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                                    <TextBox Width="56" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                             Text="{Binding YText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             AutomationProperties.Name="Screen Y coordinate" />
                                </StackPanel>
                                <Grid Margin="56,8,0,0" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource MacroButton}"
                                            Command="{Binding DataContext.SelectedMacro.PickCoordinatesCommand, ElementName=Editor}"
                                            Visibility="{Binding DataContext.SelectedMacro.IsCapturingCoordinates, ElementName=Editor, Converter={StaticResource VisibleIfFalse}}"
                                            ToolTip="After you click, point at the spot on screen. The position is captured after 3 seconds."
                                            AutomationProperties.Name="Pick screen coordinates after three seconds">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconTarget}" Margin="0,0,6,0" />
                                            <TextBlock Text="Pick in 3 s" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Cancel" Style="{StaticResource MacroButton}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.SelectedMacro.CancelCoordinatePickCommand, ElementName=Editor}"
                                            Visibility="{Binding DataContext.SelectedMacro.IsCapturingCoordinates, ElementName=Editor, Converter={StaticResource VisibleIfTrue}}"
                                            AutomationProperties.Name="Cancel coordinate pick" />
                                </Grid>
                            </StackPanel>
                            <!-- Pick and Measure share this status line. -->
                            <TextBlock Text="{Binding DataContext.SelectedMacro.CoordinatePickStatus, ElementName=Editor}" Margin="0,-2,0,8"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MacroDetailBrush}"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedMacro.CoordinatePickStatus, ElementName=Editor}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- One of three, like the wait-time scope. The macro's own shortcut button never counts as held.
                                 Sits below the coordinate picker so the picker stays in view at the minimum size; at that size
                                 this group may need a short scroll. The inspector is too narrow for the label beside the choices. -->
                            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasHeldButtons, Converter={StaticResource VisibleIfTrue}}">
                                <TextBlock Text="If a mouse button is held" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource MacroMutedBrush}"
                                           ToolTip="What this step does if you are holding a mouse button when it runs. The macro's own shortcut button never counts." />
                                <Border HorizontalAlignment="Left" Padding="2" CornerRadius="4" BorderThickness="1" TextElement.FontSize="12"
                                        Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{StaticResource MacroLineBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Stop" IsChecked="{Binding HeldButtonsStop}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     ToolTip="Stop the macro with an error at this step."
                                                     AutomationProperties.Name="If a mouse button is held, stop the macro" />
                                        <RadioButton Content="Wait" IsChecked="{Binding HeldButtonsWait}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     ToolTip="Pause at this step until every mouse button is released, then continue."
                                                     AutomationProperties.Name="If a mouse button is held, wait for release" />
                                        <RadioButton Content="Move anyway" IsChecked="{Binding HeldButtonsAllow}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     ToolTip="Move while the button is held. On the desktop this drags whatever you are holding."
                                                     AutomationProperties.Name="If a mouse button is held, move anyway" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasDuration, Converter={StaticResource VisibleIfTrue}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource MacroFieldLabel}" />
                                    <TextBox Width="96" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                             Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             ToolTip="Whole milliseconds from 0 to 3600000."
                                             AutomationProperties.Name="Step duration in milliseconds" />
                                    <TextBlock Text="ms" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="0 uses automatic hold timing." Margin="56,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MacroMutedBrush}"
                                           Visibility="{Binding HasHold, Converter={StaticResource VisibleIfTrue}}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" Visibility="{Binding IsWheel, Converter={StaticResource VisibleIfTrue}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Delta" Style="{StaticResource MacroFieldLabel}" />
                                    <TextBox Width="96" MinHeight="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource MacroInputLineBrush}"
                                             Text="{Binding WheelDeltaText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             ToolTip="Nonzero whole number from -32768 to 32767. 120 is one notch."
                                             AutomationProperties.Name="Wheel delta" />
                                </StackPanel>
                                <Border Margin="56,8,0,0" HorizontalAlignment="Left" Padding="2" CornerRadius="4" BorderThickness="1" TextElement.FontSize="12"
                                        Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{StaticResource MacroLineBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Vertical" IsChecked="{Binding IsVerticalWheel}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     AutomationProperties.Name="Vertical mouse wheel" />
                                        <RadioButton Content="Horizontal" IsChecked="{Binding IsHorizontalWheel}" Padding="9,4" Style="{DynamicResource SegmentRadioButtonStyle}"
                                                     AutomationProperties.Name="Horizontal mouse wheel" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Field errors, or the macro's playback problem when it names this step (Show step lands here). -->
                            <TextBlock Text="{Binding DisplayError}" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MacroErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisplayError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProblemOnly}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MacroWarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Margin="0,4,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource MacroLineBrush}">
                                <TextBlock Text="{Binding KindHelp}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MacroMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- First run: nothing to select yet. -->
        <StackPanel MaxWidth="400" Margin="0,0,0,48" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource VisibleIfFalse}}">
            <TextBlock Text="No macros in this profile" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}" />
            <TextBlock Text="A macro plays back keys, clicks, cursor moves, and waits when you press its shortcut while this profile is active."
                       FontSize="13" Margin="0,8,0,16" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MacroMutedBrush}" />
            <Button Style="{StaticResource MacroPrimaryButton}" Command="{Binding NewMacroCommand}" HorizontalAlignment="Center"
                    MinHeight="34" Padding="16,0" AutomationProperties.Name="Create first macro">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource MacroIcon}" Data="{StaticResource MacroIconAdd}" Margin="0,0,6,0" />
                    <TextBlock Text="New macro…" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- With the section off the button above is disabled; say how to enable it. A disabled or read-only
                 profile locks that switch too, and its own notice above already explains why. -->
            <TextBlock Text="Turn on Macros above to create one." FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{StaticResource MacroWarningBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEnabled}" Value="False" />
                                    <Condition Binding="{Binding CanEdit}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        </Grid>
        </Grid>
        </GroupBox>
        </Border>
    </Grid>
</UserControl>
