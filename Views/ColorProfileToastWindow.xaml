<Window x:Class="sWinShortcuts.Views.ColorProfileToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Profile Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0">
    <!-- Click-through 2-second toast naming the color preset the global toggle key flipped to
         (driven by ColorProfileToastService). Ex-styles (WS_EX_TRANSPARENT | WS_EX_NOACTIVATE |
         WS_EX_TOOLWINDOW) are OR-ed in from code-behind once the HWND exists, exactly like the
         Rapid Fire status dot. Left/Top are pinned non-NaN so WPF's Manual startup location never
         re-cascades over our raw SetWindowPos positioning. -->
    <Border x:Name="ToastBorder"
            Background="#E60E141D"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,3">
        <TextBlock x:Name="ToastText"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ForegroundPrimaryBrush}" />
    </Border>
</Window>
