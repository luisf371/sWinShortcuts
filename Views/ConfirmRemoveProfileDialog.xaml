<Window x:Class="sWinShortcuts.Views.ConfirmRemoveProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Profile"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <!-- Background is explicit on purpose (same as AddProfileDialog): an implicit Window style never
         reaches a x:Class-derived window, so without this the margin around the dark inner border
         renders with the light system default. Inner text is colored by the implicit app-wide
         TextBlock style. -->
    <Grid Margin="24" MinWidth="440" MaxWidth="560">
        <Border Padding="16"
                Background="{DynamicResource BackgroundElevatedBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource WarningIconStyle}" Margin="0" />
                    <TextBlock Text="Remove Profile"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           Grid.Row="2"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- No IsDefault on Remove on purpose: Enter must not confirm a destructive
                         action. Esc cancels via IsCancel. -->
                    <Button Content="Cancel"
                            Width="96"
                            Height="30"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            AutomationProperties.Name="Cancel removal"
                            Click="OnCancelClick"/>
                    <Button x:Name="RemoveButton"
                            Content="Remove"
                            Width="96"
                            Height="30"
                            AutomationProperties.Name="Confirm removal"
                            Click="OnRemoveClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
