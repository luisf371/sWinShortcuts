<Window x:Class="sWinShortcuts.Views.CursorCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor countdown"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Opacity="0"
        Left="0"
        Top="0">
    <!-- Click-through and never activated, like CrosshairWindow. It stays transparent until the first
         frame places it beside the cursor. -->
    <Border Background="#E6202024" BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,5,10,5">
        <StackPanel Orientation="Horizontal">
            <Grid x:Name="Dial" Width="26" Height="26" Margin="0,0,7,0">
                <Ellipse Stroke="#40FFFFFF" StrokeThickness="3" />
                <Path x:Name="Ring" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="Digit" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="Caption" Foreground="White" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
