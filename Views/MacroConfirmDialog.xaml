<Window x:Class="sWinShortcuts.Views.MacroConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <!-- Same frame as ConfirmRemoveProfileDialog: the explicit Background is needed because an implicit Window
         style never reaches a x:Class-derived window. The heading asks the question the action button answers. -->
    <Grid Margin="24" MinWidth="440" MaxWidth="560">
        <Border Padding="16"
                Background="{DynamicResource BackgroundElevatedBrush}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource WarningIconStyle}" Margin="0" />
                    <TextBlock x:Name="HeadingText"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           Grid.Row="2"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- No IsDefault on the action on purpose: Enter must not confirm a destructive edit.
                         Esc cancels via IsCancel. -->
                    <Button Content="Cancel"
                            Width="96"
                            Height="30"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            AutomationProperties.Name="Cancel"
                            Click="OnCancelClick"/>
                    <Button x:Name="ConfirmButton"
                            MinWidth="96"
                            Height="30"
                            Padding="12,0"
                            Click="OnConfirmClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
