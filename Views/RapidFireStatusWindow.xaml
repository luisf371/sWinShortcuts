<Window x:Class="sWinShortcuts.Views.RapidFireStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapid Fire Status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0">
    <!-- Click-through status dot (~2 mm / 8 raw px @96 dpi) for the sticky Rapid Fire arm.
         Ex-styles (WS_EX_TRANSPARENT | WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW) are OR-ed in from
         code-behind once the HWND exists. Left/Top are pinned non-NaN so WPF's Manual startup
         location never re-cascades over our raw SetWindowPos positioning. -->
    <Grid>
        <Ellipse x:Name="StatusDot"/>
        <!-- Right-button gate mark: a small black center (3 raw px, sized in code-behind), shown only on Ready. -->
        <Ellipse x:Name="GateDot"
                 Width="3"
                 Height="3"
                 Fill="Black"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"/>
    </Grid>
</Window>
